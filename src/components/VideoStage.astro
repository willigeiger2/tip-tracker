---
// Full-viewport stage: the video element, the overlay canvas, and slotted UI (panel, transport).
// Its script owns stage presentation (mirroring, fit, edit-mode clicks) and starts the app.
---

<div id="container">
  <video id="video" class="video-element fit-cover mirrored" autoplay playsinline muted></video>
  <canvas id="overlay" class="overlay-canvas mirrored"></canvas>
  <slot />
</div>

<script>
  import { queryAll } from '../lib/client/dom';
  import { appState, clearTrails, events, isVideoSource, mapToNormalized, overlay, session, video } from '../lib/client/app';
  import { startApp } from '../lib/client/boot';
  import { applyAutoAdvance, isEditorActive, upsertActiveKeyframe } from '../lib/client/recorded';

  const cameraOnlyElements = queryAll<HTMLElement>('.camera-only');
  const videoOnlyElements = queryAll<HTMLElement>('.video-only');

  function applySourcePresentation(): void {
    const source = session.activeSource;
    video.classList.toggle('mirrored', source.mirrored);
    overlay.classList.toggle('mirrored', source.mirrored);
    video.classList.toggle('fit-cover', source.fit === 'cover');
    video.classList.toggle('fit-contain', source.fit === 'contain');

    const inCameraMode = source.kind === 'camera';
    for (const el of cameraOnlyElements) el.classList.toggle('hidden', !inCameraMode);
    for (const el of videoOnlyElements) el.classList.toggle('hidden', inCameraMode);
  }

  function updateEditMode(): void {
    overlay.classList.toggle('edit-mode', isEditorActive());
  }

  events.on('source', () => {
    applySourcePresentation();
    updateEditMode();
  });
  events.on('recorded', updateEditMode);
  appState.on('trackingMode', updateEditMode);

  // Keyframe editor: click on the video places/replaces a keyframe for the active track.
  overlay.addEventListener('click', (e) => {
    if (!isEditorActive()) return;
    video.pause();
    const norm = mapToNormalized(e.clientX, e.clientY);
    upsertActiveKeyframe(norm.x, norm.y);
    applyAutoAdvance();
  });

  video.addEventListener('seeking', () => {
    if (isVideoSource()) clearTrails();
  });

  startApp();
</script>

<style>
  #container {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    height: -webkit-fill-available;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #000;
    position: fixed;
    top: 0;
    left: 0;
    overflow: hidden;
  }

  .video-element {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .video-element.fit-cover {
    object-fit: cover;
  }

  .video-element.fit-contain {
    object-fit: contain;
  }

  .video-element.mirrored {
    transform: scaleX(-1);
  }

  .overlay-canvas {
    position: absolute;
    pointer-events: none;
    width: 100%;
    height: 100%;
  }

  .overlay-canvas.edit-mode {
    pointer-events: auto;
    cursor: crosshair;
  }

  .overlay-canvas.mirrored {
    transform: scaleX(-1);
  }
</style>
