---
// Collapsible controls panel + hamburger toggle. Panel sections are passed in the default slot.
// Shared form/button styles for all panel sections live here (global, scoped under #controls via
// :where() so they keep element-level specificity and sections can override them).
---

<button id="menuToggle" aria-label="Toggle menu">
  <span></span>
  <span></span>
  <span></span>
</button>

<div id="controls" class="collapsed">
  <h1>Tip Track</h1>
  <slot />
</div>

<script>
  import { byId } from '../lib/client/dom';
  import { stage } from '../lib/client/app';
  import { isEditorActive } from '../lib/client/recorded';

  const menuToggle = byId<HTMLElement>('menuToggle');
  const controls = byId<HTMLElement>('controls');

  menuToggle.addEventListener('click', () => {
    controls.classList.toggle('collapsed');
  });

  // Clicking outside the panel collapses it (except clicks on the stage while editing keyframes).
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (isEditorActive() && stage.contains(target)) return;
    if (!controls.contains(target) && !menuToggle.contains(target)) {
      controls.classList.add('collapsed');
    }
  });
</script>

<style>
  #menuToggle {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 50px;
    height: 50px;
    background: linear-gradient(180deg, rgba(40, 40, 40, 0.6) 0%, rgba(0, 0, 0, 0.6) 100%);
    border: none;
    border-radius: 10px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    padding: 12px;
    z-index: 1001;
    transition: background 0.3s ease;
  }

  #menuToggle:hover {
    background: linear-gradient(180deg, rgba(60, 60, 60, 0.7) 0%, rgba(20, 20, 20, 0.7) 100%);
  }

  #menuToggle span {
    width: 30px;
    height: 3px;
    background: white;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  #controls {
    position: absolute;
    top: 20px;
    right: 20px;
    background: linear-gradient(180deg, rgba(45, 45, 45, 0.75) 0%, rgba(0, 0, 0, 0.75) 100%);
    backdrop-filter: blur(10px);
    padding: 25px;
    border-radius: 12px;
    color: white;
    min-width: 280px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    transition: transform 0.3s ease, opacity 0.3s ease;
    z-index: 1000;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  #controls.collapsed {
    transform: translateX(calc(100% + 40px));
    opacity: 0;
    pointer-events: none;
  }

  h1 {
    margin: 35px 0 20px 0;
    font-size: 1.75rem;
    font-weight: 600;
    text-align: center;
    color: white;
  }

  #controls::-webkit-scrollbar {
    width: 6px;
  }

  #controls::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 3px;
  }

  #controls::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
  }

  #controls::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.3);
  }
</style>

<style is:global>
  :where(#controls) .control-group {
    margin-bottom: 18px;
  }

  :where(#controls) .control-group:last-child {
    margin-bottom: 0;
  }

  :where(#controls) label {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 6px;
    color: rgba(255, 255, 255, 0.9);
  }

  :where(#controls) select,
  :where(#controls) input[type="range"],
  :where(#controls) input[type="url"],
  :where(#controls) textarea {
    width: 100%;
    padding: 8px 10px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.1);
    color: white;
    font-size: 0.9rem;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  :where(#controls) input[type="url"] {
    cursor: text;
  }

  :where(#controls) textarea {
    min-height: 76px;
    resize: vertical;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.78rem;
    cursor: text;
  }

  :where(#controls) select:focus,
  :where(#controls) input:focus {
    outline: none;
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.15);
  }

  :where(#controls) select option {
    background: #1a1a1a;
    color: white;
  }

  :where(#controls) input[type="range"] {
    padding: 0;
    height: 6px;
    -webkit-appearance: none;
    appearance: none;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    cursor: pointer;
  }

  :where(#controls) input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: white;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  :where(#controls) input[type="range"]::-webkit-slider-thumb:hover {
    transform: scale(1.1);
  }

  :where(#controls) input[type="range"]::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: white;
    cursor: pointer;
    border: none;
  }

  :where(#controls) .hint {
    display: block;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 4px;
    font-style: italic;
  }

  :where(#controls) .advanced-controls {
    margin: 15px 0;
    padding: 10px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  :where(#controls) .advanced-controls summary {
    cursor: pointer;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    user-select: none;
    transition: color 0.2s ease;
  }

  :where(#controls) .advanced-controls summary:hover {
    color: rgba(255, 255, 255, 0.9);
  }

  :where(#controls) .advanced-controls[open] summary {
    margin-bottom: 15px;
  }

  :where(#controls) .button-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  :where(#controls) .compact-btn {
    margin-top: 8px;
    padding: 9px;
    font-size: 0.85rem;
  }

  :where(#controls) .recorded-actions {
    margin-top: 8px;
    display: flex;
    gap: 8px;
    align-items: center;
  }

  :where(#controls) .recorded-actions button {
    width: auto;
    flex: 1;
    margin-top: 0;
  }

  :where(#controls) .recorded-editor {
    margin-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 10px;
  }

  :where(#controls) .inline-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  :where(#controls) .inline-toggle input[type="checkbox"] {
    width: auto;
    margin: 0;
  }

  :where(#controls) .recorded-list-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  :where(#controls) button {
    width: 100%;
    padding: 12px;
    border-radius: 8px;
    border: 2px solid transparent;
    font-size: 0.95rem;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  :where(#controls) .btn-primary {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
    color: white;
  }

  :where(#controls) .btn-primary:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateY(-1px);
  }

  :where(#controls) .btn-secondary {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.8);
  }

  :where(#controls) .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
  }

  :where(#controls) .recorded-keyframe-list {
    max-height: 180px;
    overflow-y: auto;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    padding: 4px;
  }
</style>
