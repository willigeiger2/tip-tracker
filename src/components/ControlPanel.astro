---
// Collapsible controls panel + hamburger toggle. Markup only; behavior is wired in index.astro
// by element id, so ids here are part of the page's contract.
---

<!-- Hamburger Menu Toggle -->
<button id="menuToggle" aria-label="Toggle menu">
  <span></span>
  <span></span>
  <span></span>
</button>

<!-- Collapsible Controls Panel -->
<div id="controls" class="collapsed">
  <h1>Tip Track</h1>

  <div class="control-group">
    <label for="sourceMode">Source</label>
    <select id="sourceMode">
      <option value="camera">Camera</option>
      <option value="video">Video URL</option>
    </select>
  </div>

  <div id="videoSourceGroup" class="control-group video-only hidden">
    <label for="videoUrl">Video URL (HLS or MP4 with CORS)</label>
    <input
      type="url"
      id="videoUrl"
      placeholder="https://.../manifest/video.m3u8"
      spellcheck="false"
      autocomplete="off"
    />
    <button id="loadVideo" type="button" class="btn-secondary compact-btn">Load Video</button>
    <small class="hint">Tip: add <code>?video=&lt;url&gt;</code> to auto-load this clip.</small>
  </div>
  
  <div class="control-group">
    <label for="trackingMode">Tracking Mode</label>
    <select id="trackingMode">
      <option value="hand">Hand Tracking (Demo)</option>
      <option value="pose">Pose Tracking (Full Body)</option>
      <option value="fencers">Fencers Tracking (2 Pose)</option>
      <option value="recorded">Recorded Points (Video Only)</option>
    </select>
    <small class="hint">Hand: index fingertip = sword tip. Clash flash is hand mode only.</small>
    <button id="recordedGenerateDraft" type="button" class="btn-secondary compact-btn video-only hidden">
      Generate Recorded Draft
    </button>
    <small id="recordedGenerateHint" class="hint video-only hidden">
      Capture live hand/pose tips while playing, then generate editable recorded keyframes.
    </small>
  </div>

  <div id="recordedPanel" class="control-group video-only hidden">
    <label for="recordedJsonInput">Recorded Tracks (A green, B red)</label>
    <textarea
      id="recordedJsonInput"
      rows="4"
      placeholder="Paste RecordedTrackSet JSON here"
      spellcheck="false"
    ></textarea>
    <div class="recorded-actions">
      <button id="recordedImportPaste" type="button" class="btn-secondary compact-btn">Import JSON</button>
      <button id="recordedExportJson" type="button" class="btn-secondary compact-btn">Export JSON</button>
    </div>
    <input id="recordedImportFile" type="file" accept="application/json,.json" class="hidden" />
    <small class="hint">Tip: leave the JSON box empty and click Import JSON to pick a file.</small>
    <span id="recordedStatus" class="hint">No recorded keyframes loaded.</span>

    <div class="recorded-editor">
      <label class="inline-toggle">
        <input id="recordedEditToggle" type="checkbox" />
        <span>Edit keyframes</span>
      </label>

      <div id="recordedEditorControls" class="hidden">
        <div class="recorded-editor-grid">
        <label for="recordedActiveTrack">Active Track</label>
        <select id="recordedActiveTrack">
          <option value="A">Track A (Green)</option>
          <option value="B">Track B (Red)</option>
        </select>

        <label for="recordedAutoAdvance">Auto-advance</label>
        <select id="recordedAutoAdvance">
          <option value="0">Off</option>
          <option value="1">1 frame</option>
          <option value="2" selected>2 frames</option>
          <option value="5">5 frames</option>
          <option value="10">10 frames</option>
        </select>
        </div>

        <div class="recorded-actions">
          <button id="recordedDeleteFrame" type="button" class="btn-secondary compact-btn">Delete At Frame</button>
          <button id="recordedClearTrack" type="button" class="btn-secondary compact-btn">Clear Track</button>
        </div>

        <div class="recorded-list-wrap">
          <div class="recorded-list-header">
            <span>Keyframes</span>
            <small class="hint">Jump: [ ] or , .</small>
          </div>
          <div id="recordedKeyframeList" class="recorded-keyframe-list"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="control-group">
    <label for="debugMode">Debug Mode</label>
    <select id="debugMode">
      <option value="none">Production (Trails)</option>
      <option value="landmarks">Landmarks</option>
      <option value="skeleton">Skeleton</option>
      <option value="vectors">Vectors + Grid</option>
      <option value="tips-only">Tip Points</option>
      <option value="trails-only">Trails Only</option>
      <option value="lightsaber">Lightsaber</option>
      <option value="heatmap">Heatmap</option>
      <option value="all">All Debug</option>
    </select>
  </div>

  <div class="control-group">
    <label for="trailLength">
      Trail Length: <span id="trailLengthValue">30</span>
    </label>
    <input
      type="range"
      id="trailLength"
      min="5"
      max="120"
      value="30"
      step="5"
    />
  </div>

  <div class="control-group">
    <label for="inferenceRate">
      Inference Rate: <span id="inferenceRateValue">15</span> fps
    </label>
    <input 
      type="range" 
      id="inferenceRate" 
      min="5" 
      max="30" 
      value="15" 
      step="1"
    />
  </div>

  <details class="advanced-controls">
    <summary>Advanced / Effects</summary>
    <div class="control-group">
      <label for="effectMode">Effect Mode</label>
      <select id="effectMode">
        <option value="none">None</option>
        <option value="lightsaber-glow">Lightsaber Glow</option>
        <option value="matrix">Matrix</option>
        <option value="motion-blur">Motion Blur</option>
      </select>
    </div>
    <div class="control-group">
      <label for="glowIntensity">
        Glow Intensity: <span id="glowIntensityValue">1.0</span>
      </label>
      <input 
        type="range" 
        id="glowIntensity" 
        min="0" 
        max="2" 
        value="1" 
        step="0.1"
      />
    </div>
    <div class="control-group">
      <label for="poseTipExtension">
        Pose Tip Extension: <span id="poseTipExtensionValue">4.2</span>x
      </label>
      <input
        type="range"
        id="poseTipExtension"
        min="1"
        max="8"
        value="4.2"
        step="0.1"
      />
      <small class="hint">Pose mode only. Higher values push the tip farther past the wrist.</small>
    </div>
  </details>

  <div class="control-group button-group">
    <button id="clearTrails" class="btn-secondary">Clear Trails</button>
    <button id="toggleCamera" class="btn-primary camera-only">Start Camera</button>
  </div>

  <div class="status">
    <span id="detectionStatus">Initializing...</span>
    <span id="playbackStatus">camera</span>
    <span id="fpsCounter">-- fps</span>
  </div>
</div>

<style>
  /* Hamburger Menu Toggle */
  #menuToggle {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 50px;
    height: 50px;
    background: linear-gradient(180deg, rgba(40, 40, 40, 0.6) 0%, rgba(0, 0, 0, 0.6) 100%);
    border: none;
    border-radius: 10px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    z-index: 1001;
    transition: background 0.3s ease;
  }

  #menuToggle:hover {
    background: linear-gradient(180deg, rgba(60, 60, 60, 0.7) 0%, rgba(20, 20, 20, 0.7) 100%);
  }

  #menuToggle span {
    width: 30px;
    height: 3px;
    background: white;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  /* Controls Panel */
  #controls {
    position: absolute;
    top: 20px;
    right: 20px;
    background: linear-gradient(180deg, rgba(45, 45, 45, 0.75) 0%, rgba(0, 0, 0, 0.75) 100%);
    backdrop-filter: blur(10px);
    padding: 25px;
    border-radius: 12px;
    color: white;
    min-width: 280px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    transition: transform 0.3s ease, opacity 0.3s ease;
    z-index: 1000;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  #controls.collapsed {
    transform: translateX(calc(100% + 40px));
    opacity: 0;
    pointer-events: none;
  }

  h1 {
    margin: 35px 0 20px 0;
    font-size: 1.75rem;
    font-weight: 600;
    text-align: center;
    color: white;
  }

  .control-group {
    margin-bottom: 18px;
  }

  .control-group:last-child {
    margin-bottom: 0;
  }

  label {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 6px;
    color: rgba(255, 255, 255, 0.9);
  }

  select,
  input[type="range"],
  input[type="url"],
  textarea {
    width: 100%;
    padding: 8px 10px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.1);
    color: white;
    font-size: 0.9rem;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  input[type="url"] {
    cursor: text;
  }

  textarea {
    min-height: 76px;
    resize: vertical;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.78rem;
    cursor: text;
  }

  select:focus, input:focus {
    outline: none;
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.15);
  }

  select option {
    background: #1a1a1a;
    color: white;
  }

  input[type="range"] {
    padding: 0;
    height: 6px;
    -webkit-appearance: none;
    appearance: none;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    cursor: pointer;
  }

  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: white;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  input[type="range"]::-webkit-slider-thumb:hover {
    transform: scale(1.1);
  }

  input[type="range"]::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: white;
    cursor: pointer;
    border: none;
  }

  .hint {
    display: block;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 4px;
    font-style: italic;
  }

  .advanced-controls {
    margin: 15px 0;
    padding: 10px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .advanced-controls summary {
    cursor: pointer;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    user-select: none;
    transition: color 0.2s ease;
  }

  .advanced-controls summary:hover {
    color: rgba(255, 255, 255, 0.9);
  }

  .advanced-controls[open] summary {
    margin-bottom: 15px;
  }

  .button-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .compact-btn {
    margin-top: 8px;
    padding: 9px;
    font-size: 0.85rem;
  }

  .recorded-actions {
    margin-top: 8px;
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .recorded-actions button {
    width: auto;
    flex: 1;
    margin-top: 0;
  }

  .recorded-editor {
    margin-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 10px;
  }

  .inline-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .inline-toggle input[type="checkbox"] {
    width: auto;
    margin: 0;
  }

  .recorded-editor-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
  }

  .recorded-list-wrap {
    margin-top: 10px;
  }

  .recorded-list-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .recorded-keyframe-list {
    max-height: 180px;
    overflow-y: auto;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    padding: 4px;
  }

  .recorded-keyframe-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6px;
    margin-bottom: 4px;
  }

  .recorded-keyframe-row:last-child {
    margin-bottom: 0;
  }

  .recorded-keyframe-jump,
  .recorded-keyframe-delete {
    padding: 6px 8px;
    font-size: 0.78rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    cursor: pointer;
  }

  .recorded-keyframe-delete {
    min-width: 46px;
  }

  .hidden {
    display: none;
  }

  button {
    width: 100%;
    padding: 12px;
    border-radius: 8px;
    border: 2px solid transparent;
    font-size: 0.95rem;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
    color: white;
  }

  .btn-primary:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.8);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .status {
    display: flex;
    gap: 10px;
    justify-content: space-between;
    margin-top: 18px;
    padding-top: 15px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
  }

  #playbackStatus {
    font-family: monospace;
    color: rgba(255, 255, 255, 0.65);
    white-space: nowrap;
  }

  #fpsCounter {
    font-family: monospace;
    color: rgba(255, 255, 255, 0.7);
  }

  /* Scrollbar styling for controls panel */
  #controls::-webkit-scrollbar {
    width: 6px;
  }

  #controls::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 3px;
  }

  #controls::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
  }

  #controls::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.3);
  }
</style>
