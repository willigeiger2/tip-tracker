---
// Floating transport controls for video mode: play/pause, frame and keyframe stepping, seek
// slider, time/frame readout, fps badge (click to override). Also owns the keyboard shortcuts.
---

<div id="transportBar" class="video-only hidden" aria-label="Video transport">
  <button id="transportPlayPause" class="transport-btn" type="button">Play</button>
  <button id="transportStepBack" class="transport-btn" type="button" aria-label="Previous frame">
    -1f
  </button>
  <button id="transportStepForward" class="transport-btn" type="button" aria-label="Next frame">
    +1f
  </button>
  <button
    id="transportPrevKeyframe"
    class="transport-btn"
    type="button"
    aria-label="Previous keyframe"
    title="Previous keyframe ([ or ,)"
  >
    Prev KF
  </button>
  <button
    id="transportNextKeyframe"
    class="transport-btn"
    type="button"
    aria-label="Next keyframe"
    title="Next keyframe (] or .)"
  >
    Next KF
  </button>

  <div class="transport-seek-wrap">
    <input id="transportSeek" type="range" min="0" max="1" step="1" value="0" />
    <div id="transportHitTicks" class="transport-hit-ticks" aria-hidden="true"></div>
  </div>

  <span id="transportReadout">0:00.0 / 0:00.0 f0</span>
  <button id="transportFps" class="transport-fps" type="button" title="Click to override FPS">
    ~30 fps
  </button>
</div>

<script>
  import { byId } from '../lib/client/dom';
  import { frameIndex, seekTimeForFrame } from '../lib/app/frame-rate';
  import { appState, events, isVideoSource, session, video } from '../lib/client/app';
  import { formatClock } from '../lib/client/format';
  import { activeTrackHasKeyframes, getHits, getTrackSet, jumpNeighborKeyframe } from '../lib/client/recorded';
  import { installShortcuts } from '../lib/client/shortcuts';
  import {
    beginSeekDrag,
    endSeekDrag,
    frameRate,
    promptFpsOverride,
    seekDragState,
    stepFrames,
    togglePlay,
    updateSeekDrag,
  } from '../lib/client/transport';

  const playPauseBtn = byId<HTMLButtonElement>('transportPlayPause');
  const stepBackBtn = byId<HTMLButtonElement>('transportStepBack');
  const stepForwardBtn = byId<HTMLButtonElement>('transportStepForward');
  const prevKeyframeBtn = byId<HTMLButtonElement>('transportPrevKeyframe');
  const nextKeyframeBtn = byId<HTMLButtonElement>('transportNextKeyframe');
  const seek = byId<HTMLInputElement>('transportSeek');
  const readout = byId<HTMLSpanElement>('transportReadout');
  const fpsBtn = byId<HTMLButtonElement>('transportFps');
  const hitTicks = byId<HTMLDivElement>('transportHitTicks');

  /** Hit markers over the seek bar (recorded mode). Rebuilt only when hits or duration change. */
  let hitTicksKey = '';
  function renderHitTicks(duration: number): void {
    const show = appState.get().trackingMode === 'recorded' && duration > 0;
    const hits = show ? getHits() : [];
    const key = `${duration}|${hits.map((h) => `${h.trackId}${h.time}`).join(',')}`;
    if (key === hitTicksKey) return;
    hitTicksKey = key;
    const colors = new Map((getTrackSet()?.tracks ?? []).map((t) => [t.id, t.color]));
    hitTicks.innerHTML = '';
    for (const hit of hits) {
      const tick = document.createElement('span');
      const frac = Math.min(1, Math.max(0, hit.time / duration));
      // Range thumbs are ~16px wide, so the track runs from 8px to (100% - 8px).
      tick.style.left = `calc(8px + ${frac} * (100% - 16px))`;
      tick.style.background = colors.get(hit.trackId) ?? '#fff';
      hitTicks.appendChild(tick);
    }
  }

  function render(): void {
    const uiFps = frameRate();
    const hasDuration = Number.isFinite(video.duration) && video.duration > 0;
    const duration = hasDuration ? video.duration : 0;
    const currentFrame = frameIndex(video.currentTime, uiFps);
    const maxFrame = Math.max(0, frameIndex(duration, uiFps));
    const drag = seekDragState();
    renderHitTicks(duration);

    seek.min = '0';
    seek.max = String(Math.max(1, maxFrame));
    if (!drag.dragging) {
      seek.value = String(Math.min(Math.max(currentFrame, 0), Math.max(1, maxFrame)));
    }

    const displayedFrame = drag.dragging ? drag.frame : currentFrame;
    const displayedTime = drag.dragging ? seekTimeForFrame(drag.frame, uiFps, duration) : video.currentTime;
    readout.textContent = `${formatClock(displayedTime)} / ${formatClock(duration)}  f${displayedFrame}`;

    playPauseBtn.textContent = video.paused || video.ended ? 'Play' : 'Pause';

    const disabled = !isVideoSource() || !hasDuration;
    seek.disabled = disabled;
    playPauseBtn.disabled = disabled;
    stepBackBtn.disabled = disabled;
    stepForwardBtn.disabled = disabled;
    prevKeyframeBtn.disabled = disabled || !activeTrackHasKeyframes();
    nextKeyframeBtn.disabled = disabled || !activeTrackHasKeyframes();

    const fps = session.transportFps;
    const fpsText = fps >= 100 ? fps.toFixed(0) : fps.toFixed(2).replace(/\.00$/, '');
    fpsBtn.textContent = `${session.transportFpsApproximate ? '~' : ''}${fpsText} fps`;
    fpsBtn.disabled = !isVideoSource() || !session.currentVideoId;
  }

  playPauseBtn.addEventListener('click', () => void togglePlay());
  stepBackBtn.addEventListener('click', () => stepFrames(-1));
  stepForwardBtn.addEventListener('click', () => stepFrames(1));
  prevKeyframeBtn.addEventListener('click', () => jumpNeighborKeyframe(-1));
  nextKeyframeBtn.addEventListener('click', () => jumpNeighborKeyframe(1));
  fpsBtn.addEventListener('click', () => promptFpsOverride());

  seek.addEventListener('pointerdown', () => beginSeekDrag());
  seek.addEventListener('input', () => updateSeekDrag(Number.parseInt(seek.value, 10)));
  const commitSeekFromSlider = () => endSeekDrag(Number.parseInt(seek.value, 10));
  seek.addEventListener('change', commitSeekFromSlider);
  seek.addEventListener('pointerup', commitSeekFromSlider);

  for (const eventName of ['loadedmetadata', 'loadeddata', 'durationchange', 'timeupdate', 'play', 'pause', 'seeking', 'seeked', 'ended', 'resize']) {
    video.addEventListener(eventName, render);
  }
  events.on('transport', render);
  events.on('recorded', render);
  events.on('source', render);
  appState.on('trackingMode', render);

  installShortcuts();
</script>

<style>
  #transportBar {
    position: absolute;
    left: 50%;
    bottom: max(12px, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 8px;
    width: min(960px, calc(100vw - 24px));
    padding: 10px 12px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(5, 5, 5, 0.8);
    backdrop-filter: blur(8px);
    color: #fff;
    z-index: 900;
  }

  .transport-btn,
  .transport-fps {
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-size: 0.8rem;
    font-family: inherit;
    padding: 6px 10px;
    cursor: pointer;
    white-space: nowrap;
  }

  .transport-btn:hover,
  .transport-fps:hover {
    background: rgba(255, 255, 255, 0.14);
  }

  .transport-btn:disabled,
  .transport-fps:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .transport-seek-wrap {
    position: relative;
    flex: 1;
    min-width: 110px;
    margin: 0 4px;
    display: flex;
    align-items: center;
  }

  #transportSeek {
    width: 100%;
    margin: 0;
    cursor: pointer;
  }

  .transport-hit-ticks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .transport-hit-ticks :global(span) {
    position: absolute;
    top: 0;
    width: 3px;
    height: 100%;
    margin-left: -1.5px;
    border-radius: 2px;
    opacity: 0.9;
  }

  #transportReadout {
    min-width: 170px;
    font-size: 0.78rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color: rgba(255, 255, 255, 0.9);
    text-align: right;
    white-space: nowrap;
  }

  .transport-fps {
    min-width: 72px;
    text-align: center;
  }

  @media (max-width: 760px) {
    #transportBar {
      width: calc(100vw - 12px);
      gap: 6px;
      padding: 8px;
    }

    #transportReadout {
      min-width: 120px;
      font-size: 0.72rem;
    }

    .transport-btn,
    .transport-fps {
      padding: 5px 8px;
      font-size: 0.74rem;
    }
  }
</style>
