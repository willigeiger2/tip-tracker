---
// Source picker (camera / video URL) and the video URL loader.
---

<div class="control-group">
  <label for="sourceMode">Source</label>
  <select id="sourceMode">
    <option value="camera">Camera</option>
    <option value="video">Video URL</option>
  </select>
</div>

<div id="videoSourceGroup" class="control-group video-only hidden">
  <label for="videoUrl">Video URL (HLS or MP4 with CORS)</label>
  <input
    type="url"
    id="videoUrl"
    placeholder="https://.../manifest/video.m3u8"
    spellcheck="false"
    autocomplete="off"
  />
  <button id="loadVideo" type="button" class="btn-secondary compact-btn">Load Video</button>
  <small class="hint">Tip: add <code>?video=&lt;url&gt;</code> to auto-load this clip.</small>
</div>

<script>
  import { byId } from '../../lib/client/dom';
  import { events, session } from '../../lib/client/app';
  import type { SourceKind } from '../../lib/app/sources/source';
  import { loadVideo, switchSource } from '../../lib/client/sources';

  const sourceModeSelect = byId<HTMLSelectElement>('sourceMode');
  const videoUrlInput = byId<HTMLInputElement>('videoUrl');
  const loadVideoBtn = byId<HTMLButtonElement>('loadVideo');

  const loadFromInput = () => void loadVideo(videoUrlInput.value.trim());

  sourceModeSelect.addEventListener('change', () => {
    void switchSource(sourceModeSelect.value as SourceKind);
  });
  loadVideoBtn.addEventListener('click', loadFromInput);
  videoUrlInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      loadFromInput();
    }
  });

  events.on('source', () => {
    sourceModeSelect.value = session.activeSource.kind;
  });
  events.on('video-url', (url) => {
    videoUrlInput.value = url;
  });
</script>
