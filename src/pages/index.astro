---
// The Tip Track app: a full-viewport video stage with the controls panel and transport bar.
// All behaviour lives in the components' scripts and src/lib/client.
import Layout from '../layouts/Layout.astro';
import VideoStage from '../components/VideoStage.astro';
import ControlPanel from '../components/ControlPanel.astro';
import Transport from '../components/Transport.astro';
import SourceControls from '../components/panel/SourceControls.astro';
import TrackingControls from '../components/panel/TrackingControls.astro';
import FencersPanel from '../components/panel/FencersPanel.astro';
import RecordedPanel from '../components/panel/RecordedPanel.astro';
import SavedVideosPanel from '../components/panel/SavedVideosPanel.astro';
import DisplayControls from '../components/panel/DisplayControls.astro';
import PanelFooter from '../components/panel/PanelFooter.astro';
---

<Layout>
  <VideoStage>
    <ControlPanel>
      <SourceControls />
      <TrackingControls>
        <FencersPanel />
      </TrackingControls>
      <RecordedPanel />
      <SavedVideosPanel />
      <DisplayControls />
      <PanelFooter />
    </ControlPanel>
    <Transport />
  </VideoStage>
</Layout>
