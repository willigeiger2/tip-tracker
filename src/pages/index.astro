---
import Layout from '../layouts/Layout.astro';
import ControlPanel from '../components/ControlPanel.astro';
import Transport from '../components/Transport.astro';
---

<Layout>
  <div id="container">
    <video id="video" class="video-element fit-cover mirrored" autoplay playsinline muted></video>
    <canvas id="overlay" class="overlay-canvas mirrored"></canvas>

    <ControlPanel />
    <Transport />
  </div>
</Layout>

<script>
  // Page bootstrap: look up DOM elements, construct app modules, bind UI events.
  import {
    initDetector,
    detect,
    resetCurrentDetector,
    setFencerLengthSmoothingAlpha,
    setFencerTipRefinementEnabled,
  } from '../lib/unified-detector';
  import { TrailManager } from '../lib/trail-manager';
  import { TrailRenderer, DebugRenderer } from '../lib/renderer';
  import { EffectManager } from '../lib/effects';
  import { setFencerDirectionTuning, setPoseTipExtension } from '../lib/tip-estimator';
  import {
    DEFAULT_FRAME_RATE,
    detectVideoFrameRate,
    frameIndex,
    loadFpsOverride,
    saveFpsOverride,
    seekTimeForFrame,
  } from '../lib/app/frame-rate';
  import { createCoordinateMapper, createInverseCoordinateMapper } from '../lib/app/coordinate-mapper';
  import { createAppState } from '../lib/app/state';
  import type { FrameData, RenderContext } from '../lib/app/render-modes';
  import { MainLoop } from '../lib/app/main-loop';
  import { installOverlaySizing } from '../lib/app/overlay-sizing';
  import { DetectorController } from '../lib/app/detector-controller';
  import { CameraSource } from '../lib/app/sources/camera-source';
  import { UrlSource, UnsupportedVideoSourceError } from '../lib/app/sources/url-source';
  import { buildRecordedFrameSnapshot } from '../lib/recorded/playback';
  import { sampleTrackAt } from '../lib/recorded/interpolator';
  import {
    createEmptyTrackSet,
    exportTrackSetToJson,
    importTrackSetFromJson,
    keyframeCount,
    loadTrackSet,
    saveTrackSet,
    trackSetToSummary,
  } from '../lib/recorded/track-store';
  import type { RecordedTrackSet, RecordedTrackSetSummary } from '../lib/recorded/types';
  import {
    fetchTrackSetFromKv,
    fetchTrackSummariesFromKv,
    saveTrackSetToKv,
  } from '../lib/recorded/kv-client';
  import { keyframesFromLiveSamples, type LiveTipSample } from '../lib/recorded/auto-seed';
  import {
    deleteKeyframeAtFrame,
    keyframeAtFrame,
    listKeyframesWithFrames,
    nearestNeighborFrames,
    upsertKeyframeAtFrame,
  } from '../lib/recorded/keyframes';
  import { deriveVideoId } from '../lib/recorded/video-id';
  import type { SourceKind, VideoSource } from '../lib/app/sources/source';
  import type { DebugMode, EffectMode, TrackingMode } from '../types/fencing';

  function byId<T>(id: string): T {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Missing element #${id}`);
    return el as unknown as T;
  }

  // ---- DOM ----
  const container = byId<HTMLDivElement>('container');
  const video = byId<HTMLVideoElement>('video');
  const overlay = byId<HTMLCanvasElement>('overlay');
  const menuToggle = byId<HTMLButtonElement>('menuToggle');
  const controls = byId<HTMLDivElement>('controls');
  const sourceModeSelect = byId<HTMLSelectElement>('sourceMode');
  const videoUrlInput = byId<HTMLInputElement>('videoUrl');
  const loadVideoBtn = byId<HTMLButtonElement>('loadVideo');
  const trackingModeSelect = byId<HTMLSelectElement>('trackingMode');
  const recordedTrackingOption = trackingModeSelect.querySelector<HTMLOptionElement>(
    'option[value="recorded"]'
  );
  const debugModeSelect = byId<HTMLSelectElement>('debugMode');
  const trailLengthInput = byId<HTMLInputElement>('trailLength');
  const trailLengthValue = byId<HTMLSpanElement>('trailLengthValue');
  const inferenceRateInput = byId<HTMLInputElement>('inferenceRate');
  const inferenceRateValue = byId<HTMLSpanElement>('inferenceRateValue');
  const glowIntensityInput = byId<HTMLInputElement>('glowIntensity');
  const glowIntensityValue = byId<HTMLSpanElement>('glowIntensityValue');
  const poseTipExtensionInput = byId<HTMLInputElement>('poseTipExtension');
  const poseTipExtensionValue = byId<HTMLSpanElement>('poseTipExtensionValue');
  const effectModeSelect = byId<HTMLSelectElement>('effectMode');
  const clearTrailsBtn = byId<HTMLButtonElement>('clearTrails');
  const toggleCameraBtn = byId<HTMLButtonElement>('toggleCamera');
  const detectionStatus = byId<HTMLSpanElement>('detectionStatus');
  const playbackStatus = byId<HTMLSpanElement>('playbackStatus');
  const fpsCounter = byId<HTMLSpanElement>('fpsCounter');
  const recordedPanel = byId<HTMLDivElement>('recordedPanel');
  const recordedJsonInput = byId<HTMLTextAreaElement>('recordedJsonInput');
  const recordedImportPasteBtn = byId<HTMLButtonElement>('recordedImportPaste');
  const recordedExportJsonBtn = byId<HTMLButtonElement>('recordedExportJson');
  const recordedImportFileInput = byId<HTMLInputElement>('recordedImportFile');
  const recordedStatus = byId<HTMLSpanElement>('recordedStatus');
  const recordedGenerateDraftBtn = byId<HTMLButtonElement>('recordedGenerateDraft');
  const recordedGenerateHint = byId<HTMLSpanElement>('recordedGenerateHint');
  const fencersDebugGroup = byId<HTMLDivElement>('fencersDebugGroup');
  const fencersDebugOverlayInput = byId<HTMLInputElement>('fencersDebugOverlay');
  const fencersTipRefinementEnabledInput = byId<HTMLInputElement>('fencersTipRefinementEnabled');
  const fencerATipExtensionInput = byId<HTMLInputElement>('fencerATipExtension');
  const fencerATipExtensionValue = byId<HTMLSpanElement>('fencerATipExtensionValue');
  const fencerALengthSmoothingAlphaInput = byId<HTMLInputElement>('fencerALengthSmoothingAlpha');
  const fencerALengthSmoothingAlphaValue = byId<HTMLSpanElement>('fencerALengthSmoothingAlphaValue');
  const fencerAWristWeightInput = byId<HTMLInputElement>('fencerAWristWeight');
  const fencerAWristWeightValue = byId<HTMLSpanElement>('fencerAWristWeightValue');
  const fencerAAngleOffsetInput = byId<HTMLInputElement>('fencerAAngleOffset');
  const fencerAAngleOffsetValue = byId<HTMLSpanElement>('fencerAAngleOffsetValue');
  const fencerBTipExtensionInput = byId<HTMLInputElement>('fencerBTipExtension');
  const fencerBTipExtensionValue = byId<HTMLSpanElement>('fencerBTipExtensionValue');
  const fencerBLengthSmoothingAlphaInput = byId<HTMLInputElement>('fencerBLengthSmoothingAlpha');
  const fencerBLengthSmoothingAlphaValue = byId<HTMLSpanElement>('fencerBLengthSmoothingAlphaValue');
  const fencerBWristWeightInput = byId<HTMLInputElement>('fencerBWristWeight');
  const fencerBWristWeightValue = byId<HTMLSpanElement>('fencerBWristWeightValue');
  const fencerBAngleOffsetInput = byId<HTMLInputElement>('fencerBAngleOffset');
  const fencerBAngleOffsetValue = byId<HTMLSpanElement>('fencerBAngleOffsetValue');
  const recordedEditToggle = byId<HTMLInputElement>('recordedEditToggle');
  const recordedEditorControls = byId<HTMLDivElement>('recordedEditorControls');
  const recordedActiveTrackSelect = byId<HTMLSelectElement>('recordedActiveTrack');
  const recordedAutoAdvanceSelect = byId<HTMLSelectElement>('recordedAutoAdvance');
  const recordedDeleteFrameBtn = byId<HTMLButtonElement>('recordedDeleteFrame');
  const recordedClearTrackBtn = byId<HTMLButtonElement>('recordedClearTrack');
  const recordedKeyframeList = byId<HTMLDivElement>('recordedKeyframeList');
  const savedVideosPanel = byId<HTMLDivElement>('savedVideosPanel');
  const savedVideosRefreshBtn = byId<HTMLButtonElement>('savedVideosRefresh');
  const savedVideosList = byId<HTMLDivElement>('savedVideosList');
  const savedVideosStatus = byId<HTMLSpanElement>('savedVideosStatus');
  const transportPlayPauseBtn = byId<HTMLButtonElement>('transportPlayPause');
  const transportStepBackBtn = byId<HTMLButtonElement>('transportStepBack');
  const transportStepForwardBtn = byId<HTMLButtonElement>('transportStepForward');
  const transportPrevKeyframeBtn = byId<HTMLButtonElement>('transportPrevKeyframe');
  const transportNextKeyframeBtn = byId<HTMLButtonElement>('transportNextKeyframe');
  const transportSeek = byId<HTMLInputElement>('transportSeek');
  const transportReadout = byId<HTMLSpanElement>('transportReadout');
  const transportFpsBtn = byId<HTMLButtonElement>('transportFps');

  const cameraOnlyElements = Array.from(document.querySelectorAll<HTMLElement>('.camera-only'));
  const videoOnlyElements = Array.from(document.querySelectorAll<HTMLElement>('.video-only'));

  // ---- App modules ----
  const appState = createAppState();

  const cameraSource = new CameraSource();
  const urlSource = new UrlSource();
  let activeSource: VideoSource = cameraSource;
  let switchingSource = false;

  // Mapper tracks activeSource.fit dynamically (camera: cover, URL video: contain).
  const mapToCanvas = createCoordinateMapper(video, () => activeSource.fit);
  const mapToNormalized = createInverseCoordinateMapper(video, () => activeSource.fit);

  const trailManager = new TrailManager({ maxLength: appState.get().trailLength });
  const trailRenderer = new TrailRenderer(overlay);
  const debugRenderer = new DebugRenderer(overlay);
  const effectManager = new EffectManager(overlay.getContext('2d')!);
  const renderContext: RenderContext = { overlay, trailRenderer, debugRenderer, mapToCanvas };

  trailRenderer.setCoordinateMapper(mapToCanvas);
  trailRenderer.setGlowIntensity(appState.get().glowIntensity);
  trailRenderer.setEffectMode(appState.get().effectMode);
  debugRenderer.setCoordinateMapper(mapToCanvas);
  debugRenderer.setRates(60, appState.get().inferenceFps);

  const detector = new DetectorController({
    backend: { init: initDetector, reset: resetCurrentDetector },
    onStatus: (text) => {
      detectionStatus.textContent = text;
    },
    isSourceAttached: () => activeSource.isAttached(),
    onSwitchStart: () => {
      trailManager.clear();
      mainLoop.clearDetections();
    },
  });

  const mainLoop = new MainLoop({
    video,
    getSource: () => activeSource,
    appState,
    trailManager,
    effectManager,
    renderContext,
    detect,
    getRecordedFrame: (mediaTime, timestamp, trailSamples) => {
      if (appState.get().trackingMode !== 'recorded') return null;
      if (!recordedTrackSet) return null;
      const trailWindowSeconds = Math.max(0.25, trailSamples / Math.max(1, recordedTrackSet.fps));
      return buildRecordedFrameSnapshot(
        recordedTrackSet,
        mediaTime,
        timestamp,
        trailSamples,
        trailWindowSeconds
      );
    },
    onAfterRender: ({ overlay: overlayCanvas, trailRenderer: overlayTrailRenderer }, frame, _timestamp) => {
      captureAutoSeedSamples(frame);

      if (showFencersDebugOverlay && appState.get().trackingMode === 'fencers') {
        drawFencersDebugOverlay(overlayCanvas, frame);
      }

      if (!isRecordedEditorActive()) return;
      overlayTrailRenderer.clear();
      drawRecordedEditorOverlay(overlayCanvas);
    },
    isDetectorReady: () => detector.isReady(),
    onFps: (fps) => {
      fpsCounter.textContent = `${fps} fps`;
    },
  });

  let refreshOverlaySizing: (() => void) | null = null;
  let currentVideoId: string | null = null;
  let currentVideoUrl = '';
  let recordedTrackSet: RecordedTrackSet | null = null;
  let recordedActiveTrack: 'A' | 'B' = 'A';
  let recordedEditMode = false;
  type RecordedAutoAdvanceMode = 0 | 1 | 2 | 5 | 10 | 'next';
  const AUTO_ADVANCE_FRAME_VALUES: Array<Exclude<RecordedAutoAdvanceMode, 'next'>> = [0, 1, 2, 5, 10];
  let recordedAutoAdvanceMode: RecordedAutoAdvanceMode = 2;
  let recordedSaveTimer: number | null = null;
  let recordedSaveSequence = 0;
  let recordedStatusNote: string | null = null;
  let savedVideoSummaries: RecordedTrackSetSummary[] = [];
  let savedVideosLoading = false;
  let savedVideosRefreshSequence = 0;
  let autoSeedSamples: Record<'A' | 'B', LiveTipSample[]> = { A: [], B: [] };
  let lastAutoSeedTimestampByTrack: Record<'A' | 'B', number | null> = { A: null, B: null };
  let autoSeedCaptureMode: Exclude<TrackingMode, 'recorded'> | null = null;
  let lastAutoSeedMediaTime: number | null = null;
  let showFencersDebugOverlay = false;
  let transportFps = DEFAULT_FRAME_RATE;
  let transportFpsApproximate = true;
  let isDraggingSeek = false;
  let seekDragFrame = 0;
  let scrubPreviewRaf: number | null = null;
  let scrubPreviewFrame = 0;

  const RECORDED_AUTOSAVE_MS = 500;
  const RECORDED_AUTO_ADVANCE_STORAGE_KEY = 'tiptrack:v1:editor:auto-advance';
  const AUTO_SEED_BASE_HINT =
    'Capture live hand/pose tips while playing, then generate editable recorded keyframes.';

  function parseRecordedAutoAdvanceMode(raw: string | null): RecordedAutoAdvanceMode | null {
    if (raw === 'next') return 'next';
    const value = Number.parseInt(raw ?? '', 10);
    if (AUTO_ADVANCE_FRAME_VALUES.includes(value as Exclude<RecordedAutoAdvanceMode, 'next'>)) {
      return value as Exclude<RecordedAutoAdvanceMode, 'next'>;
    }
    return null;
  }

  const storedAutoAdvance = parseRecordedAutoAdvanceMode(localStorage.getItem(RECORDED_AUTO_ADVANCE_STORAGE_KEY));
  if (storedAutoAdvance !== null) {
    recordedAutoAdvanceMode = storedAutoAdvance;
  }
  recordedAutoAdvanceSelect.value = String(recordedAutoAdvanceMode);
  recordedActiveTrackSelect.value = recordedActiveTrack;

  const initialState = appState.get();
  fencerATipExtensionInput.value = initialState.fencerATipExtension.toFixed(1);
  fencerBTipExtensionInput.value = initialState.fencerBTipExtension.toFixed(1);
  fencerALengthSmoothingAlphaInput.value = initialState.fencerALengthSmoothingAlpha.toFixed(2);
  fencerBLengthSmoothingAlphaInput.value = initialState.fencerBLengthSmoothingAlpha.toFixed(2);
  fencerAWristWeightInput.value = String(Math.round(initialState.fencerAWristWeight * 100));
  fencerBWristWeightInput.value = String(Math.round(initialState.fencerBWristWeight * 100));
  fencerAAngleOffsetInput.value = String(initialState.fencerAAngleOffsetDeg);
  fencerBAngleOffsetInput.value = String(initialState.fencerBAngleOffsetDeg);
  fencerATipExtensionValue.textContent = initialState.fencerATipExtension.toFixed(1);
  fencerBTipExtensionValue.textContent = initialState.fencerBTipExtension.toFixed(1);
  fencerALengthSmoothingAlphaValue.textContent = initialState.fencerALengthSmoothingAlpha.toFixed(2);
  fencerBLengthSmoothingAlphaValue.textContent = initialState.fencerBLengthSmoothingAlpha.toFixed(2);
  fencerAWristWeightValue.textContent = String(Math.round(initialState.fencerAWristWeight * 100));
  fencerBWristWeightValue.textContent = String(Math.round(initialState.fencerBWristWeight * 100));
  fencerAAngleOffsetValue.textContent = String(Math.round(initialState.fencerAAngleOffsetDeg));
  fencerBAngleOffsetValue.textContent = String(Math.round(initialState.fencerBAngleOffsetDeg));
  setFencerTipRefinementEnabled(fencersTipRefinementEnabledInput.checked);

  // ---- Configuration side effects ----
  appState.on('trailLength', (value) => trailManager.setConfig({ maxLength: value }));
  appState.on('inferenceFps', (value) => debugRenderer.setRates(60, value));
  appState.on('glowIntensity', (value) => trailRenderer.setGlowIntensity(value));
  appState.on('effectMode', (value) => trailRenderer.setEffectMode(value));
  appState.on('trackingMode', (mode) => {
    trackingModeSelect.value = mode;
    void detector.switchTo(mode);
    updateFencersDebugVisibility();
    updateRecordedPanelVisibility();
    renderRecordedKeyframeList();
    updateRecordedStatus();
  });
  appState.on('poseTipExtension', (value) => setPoseTipExtension(value));
  appState.on('fencerATipExtension', (value) => setFencerDirectionTuning('A', { extensionMultiplier: value }));
  appState.on('fencerBTipExtension', (value) => setFencerDirectionTuning('B', { extensionMultiplier: value }));
  appState.on('fencerALengthSmoothingAlpha', (value) => setFencerLengthSmoothingAlpha('A', 1 - value));
  appState.on('fencerBLengthSmoothingAlpha', (value) => setFencerLengthSmoothingAlpha('B', 1 - value));
  appState.on('fencerAWristWeight', (value) => setFencerDirectionTuning('A', { wristWeight: value }));
  appState.on('fencerBWristWeight', (value) => setFencerDirectionTuning('B', { wristWeight: value }));
  appState.on('fencerAAngleOffsetDeg', (value) => setFencerDirectionTuning('A', { angleOffsetDeg: value }));
  appState.on('fencerBAngleOffsetDeg', (value) => setFencerDirectionTuning('B', { angleOffsetDeg: value }));
  setPoseTipExtension(appState.get().poseTipExtension);
  setFencerDirectionTuning('A', {
    extensionMultiplier: appState.get().fencerATipExtension,
    wristWeight: appState.get().fencerAWristWeight,
    angleOffsetDeg: appState.get().fencerAAngleOffsetDeg,
  });
  setFencerDirectionTuning('B', {
    extensionMultiplier: appState.get().fencerBTipExtension,
    wristWeight: appState.get().fencerBWristWeight,
    angleOffsetDeg: appState.get().fencerBAngleOffsetDeg,
  });
  setFencerLengthSmoothingAlpha('A', 1 - appState.get().fencerALengthSmoothingAlpha);
  setFencerLengthSmoothingAlpha('B', 1 - appState.get().fencerBLengthSmoothingAlpha);

  // ---- Helpers ----
  function applySourcePresentation(): void {
    sourceModeSelect.value = activeSource.kind;

    video.classList.toggle('mirrored', activeSource.mirrored);
    overlay.classList.toggle('mirrored', activeSource.mirrored);
    video.classList.toggle('fit-cover', activeSource.fit === 'cover');
    video.classList.toggle('fit-contain', activeSource.fit === 'contain');
    video.controls = false;

    const inCameraMode = activeSource.kind === 'camera';
    for (const el of cameraOnlyElements) el.classList.toggle('hidden', !inCameraMode);
    for (const el of videoOnlyElements) el.classList.toggle('hidden', inCameraMode);

    savedVideosPanel.classList.toggle('hidden', inCameraMode);
    savedVideosRefreshBtn.disabled = inCameraMode || savedVideosLoading;
    if (inCameraMode) {
      savedVideosStatus.textContent = 'Switch to video source to browse saved library tracks.';
    } else {
      void refreshSavedVideosList({ silent: true });
    }

    updateTrackingModeAvailability();
    updateRecordedPanelVisibility();
    updateRecordedStatus();
    updateAutoSeedUi();

    updatePlaybackStatus();
  }

  function updatePlaybackStatus(): void {
    if (activeSource.kind === 'camera') {
      playbackStatus.textContent = 'camera';
      updateTransportUi();
      return;
    }

    const dimensions =
      video.videoWidth > 0 && video.videoHeight > 0
        ? `${video.videoWidth}x${video.videoHeight}`
        : '--x--';

    let state = 'paused';
    if (video.seeking) state = 'seeking';
    else if (video.ended) state = 'ended';
    else if (!video.paused) state = 'playing';

    playbackStatus.textContent = `${dimensions} ${state}`;
    updateTransportUi();
  }

  function setVideoQueryParam(url: string): void {
    const locationUrl = new URL(window.location.href);
    if (url) locationUrl.searchParams.set('video', url);
    else locationUrl.searchParams.delete('video');
    history.replaceState(null, '', locationUrl.toString());
  }

  function exportFilenameForVideo(url: string, fallbackId: string): string {
    try {
      const parsed = new URL(url);
      const base = `${parsed.hostname}${parsed.pathname}`
        .replace(/^\/+/, '')
        .replace(/[^a-zA-Z0-9._-]+/g, '_')
        .replace(/_+/g, '_')
        .slice(0, 140)
        .replace(/^_+|_+$/g, '');
      if (base) return `tiptrack-${base}.json`;
    } catch {
      // Fall through to id-based name.
    }
    return `tiptrack-${fallbackId}.json`;
  }

  function updateTrackingModeAvailability(): void {
    const inVideoMode = activeSource.kind === 'video';
    if (recordedTrackingOption) {
      recordedTrackingOption.disabled = !inVideoMode;
    }

    if (!inVideoMode && appState.get().trackingMode === 'recorded') {
      appState.update({ trackingMode: 'hand' });
    }

    updateFencersDebugVisibility();
  }

  function updateFencersDebugVisibility(): void {
    const show = appState.get().trackingMode === 'fencers';
    fencersDebugGroup.classList.toggle('hidden', !show);
    fencersDebugOverlayInput.disabled = !show;
    if (!show) {
      fencersDebugOverlayInput.checked = false;
      showFencersDebugOverlay = false;
    }
  }

  function autoSeedSampleCount(): number {
    return autoSeedSamples.A.length + autoSeedSamples.B.length;
  }

  function updateAutoSeedUi(): void {
    const inVideoMode = activeSource.kind === 'video';
    const liveTrackingMode = inVideoMode && appState.get().trackingMode !== 'recorded';
    const sampleCount = autoSeedSampleCount();

    recordedGenerateDraftBtn.classList.toggle('hidden', !liveTrackingMode);
    recordedGenerateHint.classList.toggle('hidden', !liveTrackingMode);
    recordedGenerateDraftBtn.disabled = !liveTrackingMode || !currentVideoId || sampleCount === 0;
    recordedGenerateDraftBtn.textContent = 'Generate Recorded Draft';

    if (!liveTrackingMode) {
      recordedGenerateHint.textContent = AUTO_SEED_BASE_HINT;
      return;
    }

    if (sampleCount === 0) {
      recordedGenerateHint.textContent = 'Play video in Hand or Pose mode to capture draft samples.';
      return;
    }

    const a = autoSeedSamples.A.length;
    const b = autoSeedSamples.B.length;

    recordedGenerateHint.textContent =
      `Captured ${sampleCount} live sample${sampleCount === 1 ? '' : 's'} (A ${a}, B ${b}). ` +
      'Generate a recorded draft when ready.';
  }

  function resetAutoSeedCapture(): void {
    autoSeedSamples = { A: [], B: [] };
    lastAutoSeedTimestampByTrack = { A: null, B: null };
    autoSeedCaptureMode = null;
    lastAutoSeedMediaTime = null;
    updateAutoSeedUi();
  }

  function updateRecordedPanelVisibility(): void {
    const show = activeSource.kind === 'video' && appState.get().trackingMode === 'recorded';
    recordedPanel.classList.toggle('hidden', !show);

    recordedJsonInput.disabled = !show;
    recordedImportPasteBtn.disabled = !show;
    recordedExportJsonBtn.disabled = !show;
    recordedImportFileInput.disabled = !show;
    recordedEditToggle.disabled = !show;

    updateRecordedEditorControlsVisibility();

    updateEditOverlayInteractivity();
    updateAutoSeedUi();
  }

  function updateRecordedEditorControlsVisibility(): void {
    const panelVisible = activeSource.kind === 'video' && appState.get().trackingMode === 'recorded';
    const controlsVisible = panelVisible && recordedEditMode;
    recordedEditorControls.classList.toggle('hidden', !controlsVisible);

    recordedActiveTrackSelect.disabled = !controlsVisible;
    recordedAutoAdvanceSelect.disabled = !controlsVisible;
    recordedDeleteFrameBtn.disabled = !controlsVisible;
    recordedClearTrackBtn.disabled = !controlsVisible;
  }

  function isRecordedEditorActive(): boolean {
    return (
      activeSource.kind === 'video' &&
      appState.get().trackingMode === 'recorded' &&
      recordedEditMode &&
      recordedTrackSet !== null
    );
  }

  function updateEditOverlayInteractivity(): void {
    const active = isRecordedEditorActive();
    overlay.classList.toggle('edit-mode', active);
  }

  function updateRecordedStatus(customMessage?: string): void {
    if (customMessage) {
      recordedStatus.textContent = customMessage;
      return;
    }

    if (activeSource.kind !== 'video') {
      recordedStatus.textContent = 'Recorded mode is available in video source only.';
      return;
    }

    if (!recordedTrackSet) {
      recordedStatus.textContent = 'No recorded keyframes loaded.';
      return;
    }

    const count = keyframeCount(recordedTrackSet);
    const base = `${count} keyframe${count === 1 ? '' : 's'} loaded for playback.`;
    recordedStatus.textContent = recordedStatusNote ? `${base} ${recordedStatusNote}` : base;
  }

  function getRecordedFps(): number {
    return recordedTrackSet?.fps || transportFps;
  }

  function transportFrameRate(): number {
    return appState.get().trackingMode === 'recorded' ? getRecordedFps() : transportFps;
  }

  function autoSeedFpsBasis(): number {
    // If this video already has a recorded set, keep generating drafts at that fps so playback,
    // frame math, and trail window behavior stay consistent across manual/auto iterations.
    return recordedTrackSet?.fps || transportFps;
  }

  function formatSaveClock(timestamp = Date.now()): string {
    return new Date(timestamp).toLocaleTimeString([], {
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
    });
  }

  function savedVideoTitle(summary: RecordedTrackSetSummary): string {
    try {
      const parsed = new URL(summary.videoUrl);
      const segments = parsed.pathname.split('/').filter(Boolean);
      const tail = segments[segments.length - 1];
      if (tail && tail !== 'video.m3u8') return tail;
      return summary.videoId;
    } catch {
      return summary.videoId;
    }
  }

  function upsertSavedVideoSummary(summary: RecordedTrackSetSummary): void {
    savedVideoSummaries = [...savedVideoSummaries.filter((item) => item.videoId !== summary.videoId), summary].sort(
      (a, b) => b.updatedAt - a.updatedAt
    );
    renderSavedVideosList();
  }

  function renderSavedVideosList(): void {
    if (savedVideosLoading) {
      savedVideosList.innerHTML = '<div class="hint">Loading library...</div>';
      return;
    }

    if (savedVideoSummaries.length === 0) {
      savedVideosList.innerHTML = '<div class="hint">No saved videos in library yet.</div>';
      return;
    }

    savedVideosList.innerHTML = '';
    for (const summary of savedVideoSummaries) {
      const row = document.createElement('div');
      row.className = 'saved-video-row';

      const main = document.createElement('div');
      main.className = 'saved-video-main';

      const title = document.createElement('span');
      title.className = 'saved-video-title';
      title.textContent = savedVideoTitle(summary);

      const meta = document.createElement('span');
      meta.className = 'saved-video-meta';
      const updated = formatSaveClock(summary.updatedAt);
      const keyframes = `${summary.keyframeCount} keyframe${summary.keyframeCount === 1 ? '' : 's'}`;
      meta.textContent = `${keyframes} · ${updated}`;

      main.appendChild(title);
      main.appendChild(meta);

      const loadBtn = document.createElement('button');
      loadBtn.type = 'button';
      loadBtn.className = 'saved-video-load';
      loadBtn.textContent = 'Load';
      loadBtn.dataset.videoId = summary.videoId;
      loadBtn.dataset.videoUrl = summary.videoUrl;
      if (currentVideoId === summary.videoId) {
        loadBtn.classList.add('active');
      }

      row.appendChild(main);
      row.appendChild(loadBtn);
      savedVideosList.appendChild(row);
    }
  }

  async function refreshSavedVideosList(options: { silent?: boolean } = {}): Promise<void> {
    if (activeSource.kind !== 'video') return;

    const sequence = ++savedVideosRefreshSequence;
    savedVideosLoading = true;
    savedVideosRefreshBtn.disabled = true;
    if (!options.silent) {
      savedVideosStatus.textContent = 'Loading saved video library...';
    }
    renderSavedVideosList();

    try {
      const summaries = await fetchTrackSummariesFromKv();
      if (sequence !== savedVideosRefreshSequence) return;
      savedVideoSummaries = summaries;
      const count = summaries.length;
      savedVideosStatus.textContent =
        count === 0
          ? 'No saved videos in library yet.'
          : `${count} saved video${count === 1 ? '' : 's'} in library.`;
    } catch (error) {
      if (sequence !== savedVideosRefreshSequence) return;
      console.warn('Failed to load saved videos list:', error);
      savedVideosStatus.textContent = 'Library unavailable right now.';
    } finally {
      if (sequence !== savedVideosRefreshSequence) return;
      savedVideosLoading = false;
      savedVideosRefreshBtn.disabled = false;
      renderSavedVideosList();
    }
  }

  async function loadOrCreateRecordedTrackSet(url: string): Promise<void> {
    const videoId = deriveVideoId(url);
    currentVideoId = videoId;
    currentVideoUrl = url;
    resetAutoSeedCapture();

    const local = loadTrackSet(videoId, url, transportFps);
    let remote: RecordedTrackSet | null = null;
    let remoteUnavailable = false;
    try {
      remote = await fetchTrackSetFromKv(videoId);
    } catch (error) {
      remoteUnavailable = true;
      console.warn('Failed to load track set from KV, falling back to local store:', error);
    }

    if (remote) {
      upsertSavedVideoSummary(trackSetToSummary(remote));
    }

    const chosen =
      remote && local
        ? remote.updatedAt >= local.updatedAt
          ? remote
          : local
        : remote ?? local ?? createEmptyTrackSet(videoId, url, transportFps, 1.0);

    chosen.videoId = videoId;
    chosen.videoUrl = url;
    recordedTrackSet = chosen;
    saveTrackSet(recordedTrackSet, { touchUpdatedAt: false });

    if (remote && local) {
      recordedStatusNote = remote.updatedAt >= local.updatedAt
        ? 'Loaded from library.'
        : 'Loaded local copy (newer than library).';
    } else if (remote) {
      recordedStatusNote = 'Loaded from library.';
    } else if (local && remoteUnavailable) {
      recordedStatusNote = 'Loaded local copy (library unavailable).';
    } else {
      recordedStatusNote = null;
    }

    recordedActiveTrack = 'A';
    recordedActiveTrackSelect.value = 'A';
    renderRecordedKeyframeList();

    recordedJsonInput.value = '';
    updateRecordedStatus();
  }

  async function flushRecordedAutosave(sequence: number): Promise<void> {
    if (!recordedTrackSet) return;

    const snapshot = JSON.parse(JSON.stringify(recordedTrackSet)) as RecordedTrackSet;
    const snapshotVideoId = snapshot.videoId;
    saveTrackSet(snapshot);

    try {
      const saved = await saveTrackSetToKv(snapshot);
      if (sequence !== recordedSaveSequence) return;
      if (!recordedTrackSet || saved.videoId !== recordedTrackSet.videoId) return;

      recordedTrackSet = saved;
      saveTrackSet(saved, { touchUpdatedAt: false });
      upsertSavedVideoSummary(trackSetToSummary(saved));
      recordedStatusNote = `Saved ${formatSaveClock(saved.updatedAt)}`;
    } catch (error) {
      if (sequence !== recordedSaveSequence) return;
      if (!recordedTrackSet || recordedTrackSet.videoId !== snapshotVideoId) return;
      console.warn('Failed to save track set to KV:', error);
      recordedStatusNote = 'Saved locally (offline).';
    }

    if (sequence === recordedSaveSequence && recordedTrackSet && recordedTrackSet.videoId === snapshotVideoId) {
      updateRecordedStatus();
    }
  }

  function scheduleRecordedAutosave(delayMs = RECORDED_AUTOSAVE_MS): void {
    if (!recordedTrackSet) return;

    recordedStatusNote = 'Unsaved changes...';
    updateRecordedStatus();

    const sequence = ++recordedSaveSequence;

    if (recordedSaveTimer !== null) {
      window.clearTimeout(recordedSaveTimer);
    }

    recordedSaveTimer = window.setTimeout(() => {
      recordedSaveTimer = null;
      void flushRecordedAutosave(sequence);
    }, delayMs);
  }

  function captureAutoSeedSamples(frame: FrameData): void {
    if (activeSource.kind !== 'video') return;
    if (frame.trackingMode === 'recorded') return;
    if (!activeSource.isPlaying()) return;
    if (frame.detections.length === 0) return;

    const liveMode = frame.trackingMode;
    if (autoSeedCaptureMode && autoSeedCaptureMode !== liveMode) {
      resetAutoSeedCapture();
    }
    autoSeedCaptureMode = liveMode;

    const mediaTime = video.currentTime;
    if (!Number.isFinite(mediaTime) || mediaTime < 0) return;

    if (lastAutoSeedMediaTime !== null && mediaTime < lastAutoSeedMediaTime - 0.25) {
      resetAutoSeedCapture();
      autoSeedCaptureMode = liveMode;
    }

    let capturedAny = false;

    for (const det of frame.detections) {
      const id: 'A' | 'B' = det.id === 'B' ? 'B' : 'A';
      const ts = Number.isFinite(det.tip.timestamp) ? det.tip.timestamp : Number.NaN;
      if (!Number.isFinite(ts)) continue;
      if (lastAutoSeedTimestampByTrack[id] !== null && ts <= lastAutoSeedTimestampByTrack[id] + 1e-6) {
        continue;
      }
      lastAutoSeedTimestampByTrack[id] = ts;

      autoSeedSamples[id].push({
        time: mediaTime,
        x: det.tip.x,
        y: det.tip.y,
      });
      capturedAny = true;
    }

    if (capturedAny) {
      lastAutoSeedMediaTime = mediaTime;
      updateAutoSeedUi();
    }
  }

  function generateRecordedDraftFromLive(): void {
    if (activeSource.kind !== 'video') return;
    if (appState.get().trackingMode === 'recorded') {
      detectionStatus.textContent = 'Switch to Hand or Pose mode to capture a new draft.';
      return;
    }
    if (!currentVideoId || !currentVideoUrl) {
      detectionStatus.textContent = 'Load a video first.';
      return;
    }

    let totalSamples = autoSeedSampleCount();
    if (totalSamples === 0) {
      const mediaTime = video.currentTime;
      const currentDetections = mainLoop.getDetections();
      if (Number.isFinite(mediaTime) && mediaTime >= 0 && currentDetections.length > 0) {
        for (const det of currentDetections) {
          const id: 'A' | 'B' = det.id === 'B' ? 'B' : 'A';
          autoSeedSamples[id].push({
            time: mediaTime,
            x: det.tip.x,
            y: det.tip.y,
          });
        }
        totalSamples = autoSeedSampleCount();
      }
    }

    if (totalSamples === 0) {
      detectionStatus.textContent = 'No live samples captured yet. Play in Hand or Pose mode first.';
      return;
    }

    const fps = autoSeedFpsBasis();
    const aKeyframes = keyframesFromLiveSamples(autoSeedSamples.A, fps);
    const bKeyframes = keyframesFromLiveSamples(autoSeedSamples.B, fps);

    if (aKeyframes.length === 0 && bKeyframes.length === 0) {
      detectionStatus.textContent = 'Captured samples were not usable as keyframes.';
      return;
    }

    const existingKeyframes = recordedTrackSet ? keyframeCount(recordedTrackSet) : 0;
    if (existingKeyframes > 0) {
      const replace = window.confirm(
        `Replace existing recorded keyframes (${existingKeyframes}) with generated draft ` +
          `(A ${aKeyframes.length}, B ${bKeyframes.length})?`
      );
      if (!replace) return;
    }

    const base = recordedTrackSet ?? createEmptyTrackSet(currentVideoId, currentVideoUrl, fps, 1.0);
    recordedTrackSet = {
      ...base,
      videoId: currentVideoId,
      videoUrl: currentVideoUrl,
      fps,
      tracks: base.tracks.map((track) => {
        if (track.id === 'A') return { ...track, keyframes: aKeyframes };
        if (track.id === 'B') return { ...track, keyframes: bKeyframes };
        return track;
      }),
    };

    recordedStatusNote = `Auto-seeded draft: A ${aKeyframes.length}, B ${bKeyframes.length}.`;
    recordedEditMode = false;
    recordedEditToggle.checked = false;
    updateRecordedEditorControlsVisibility();
    updateEditOverlayInteractivity();
    scheduleRecordedAutosave(0);
    renderRecordedKeyframeList();
    updateRecordedStatus();
    trailManager.clear();
    mainLoop.clearDetections();

    appState.update({ trackingMode: 'recorded' });

    const minTime = Math.min(
      ...(aKeyframes[0] ? [aKeyframes[0].time] : []),
      ...(bKeyframes[0] ? [bKeyframes[0].time] : [])
    );
    const maxTime = Math.max(
      ...(aKeyframes.length > 0 ? [aKeyframes[aKeyframes.length - 1].time] : []),
      ...(bKeyframes.length > 0 ? [bKeyframes[bKeyframes.length - 1].time] : [])
    );
    const sampledDuration =
      Number.isFinite(minTime) && Number.isFinite(maxTime) ? Math.max(0, maxTime - minTime) : 0;
    detectionStatus.textContent =
      `Generated draft: A ${aKeyframes.length}, B ${bKeyframes.length} keyframes` +
      ` (${sampledDuration.toFixed(1)}s @ ${fps.toFixed(2)}fps)`;

    resetAutoSeedCapture();
  }

  function formatClock(seconds: number): string {
    const safe = Number.isFinite(seconds) ? Math.max(0, seconds) : 0;
    const minutes = Math.floor(safe / 60);
    const sec = (safe % 60).toFixed(1).padStart(4, '0');
    return `${minutes}:${sec}`;
  }

  function updateTransportFpsBadge(): void {
    const fps = transportFps >= 100 ? transportFps.toFixed(0) : transportFps.toFixed(2).replace(/\.00$/, '');
    transportFpsBtn.textContent = `${transportFpsApproximate ? '~' : ''}${fps} fps`;
    transportFpsBtn.disabled = activeSource.kind !== 'video' || !currentVideoId;
  }

  function updateTransportUi(): void {
    const inVideoMode = activeSource.kind === 'video';
    const uiFps = transportFrameRate();
    const hasDuration = Number.isFinite(video.duration) && video.duration > 0;
    const duration = hasDuration ? video.duration : 0;
    const currentFrame = frameIndex(video.currentTime, uiFps);
    const maxFrame = Math.max(0, frameIndex(duration, uiFps));

    transportSeek.min = '0';
    transportSeek.max = String(Math.max(1, maxFrame));

    if (!isDraggingSeek) {
      transportSeek.value = String(Math.min(Math.max(currentFrame, 0), Math.max(1, maxFrame)));
    }

    const displayedFrame = isDraggingSeek ? seekDragFrame : currentFrame;
    const displayedTime = isDraggingSeek
      ? seekTimeForFrame(seekDragFrame, uiFps, duration)
      : video.currentTime;

    transportReadout.textContent = `${formatClock(displayedTime)} / ${formatClock(duration)}  f${displayedFrame}`;

    transportPlayPauseBtn.textContent = video.paused || video.ended ? 'Play' : 'Pause';

    const disabled = !inVideoMode || !hasDuration;
    transportSeek.disabled = disabled;
    transportPlayPauseBtn.disabled = disabled;
    transportStepBackBtn.disabled = disabled;
    transportStepForwardBtn.disabled = disabled;

    const activeTrack = getRecordedTrack(recordedActiveTrack);
    const hasRecordedTrackData =
      appState.get().trackingMode === 'recorded' && !!activeTrack && activeTrack.keyframes.length > 0;
    transportPrevKeyframeBtn.disabled = disabled || !hasRecordedTrackData;
    transportNextKeyframeBtn.disabled = disabled || !hasRecordedTrackData;

    updateTransportFpsBadge();
  }

  async function tryPlayVideo(): Promise<void> {
    if (activeSource.kind !== 'video') return;
    const hasSource = Boolean(video.currentSrc || video.src);
    if (!hasSource) {
      detectionStatus.textContent = 'Load a video URL first.';
      return;
    }

    if (video.ended && Number.isFinite(video.duration) && video.duration > 0) {
      const resumeTime = Math.max(0, video.duration - 1 / Math.max(1, transportFps));
      video.currentTime = resumeTime;
    }

    try {
      await video.play();
    } catch (err) {
      const message = err instanceof Error ? err.message : String(err);
      const errorName =
        typeof err === 'object' && err !== null && 'name' in err
          ? String((err as { name?: unknown }).name ?? '')
          : '';

      if (errorName === 'NotSupportedError' && currentVideoUrl) {
        detectionStatus.textContent = 'Video source got stuck, reloading...';
        try {
          urlSource.setUrl(currentVideoUrl);
          await urlSource.attach(video);
          detectionStatus.textContent = video.paused ? 'Video reloaded - tap Play' : 'Video reloaded';
          return;
        } catch (reloadErr) {
          console.error('Video reload after NotSupportedError failed:', reloadErr);
        }
      }

      console.error('Video play failed:', err);
      if (message.includes('no supported sources') || message.includes('not supported')) {
        detectionStatus.textContent = 'Video cannot play this source. Reload the URL.';
      } else {
        detectionStatus.textContent = `Playback failed: ${message}`;
      }
    }
  }

  function setTransportFps(fps: number, approximate: boolean): void {
    if (!Number.isFinite(fps) || fps <= 0) return;
    transportFps = fps;
    transportFpsApproximate = approximate;
    updateTransportUi();
  }

  async function detectTransportFps(url: string): Promise<void> {
    if (activeSource.kind !== 'video') return;
    const videoId = deriveVideoId(url);
    currentVideoId = videoId;

    const stored = loadFpsOverride(videoId);
    if (stored) {
      setTransportFps(stored, false);
      return;
    }

    setTransportFps(DEFAULT_FRAME_RATE, true);
    const detected = await detectVideoFrameRate(video, url);
    if (currentVideoId !== videoId) return;
    setTransportFps(detected.fps, detected.approximate);
  }

  function commitSeek(frame: number): void {
    if (activeSource.kind !== 'video') return;
    const uiFps = transportFrameRate();
    const duration = Number.isFinite(video.duration) ? video.duration : 0;
    video.currentTime = seekTimeForFrame(frame, uiFps, duration);
  }

  function stepFrames(deltaFrames: number): void {
    if (activeSource.kind !== 'video') return;
    const uiFps = transportFrameRate();
    video.pause();
    const nextFrame = frameIndex(video.currentTime, uiFps) + deltaFrames;
    commitSeek(nextFrame);
  }

  function seekSeconds(deltaSeconds: number): void {
    if (activeSource.kind !== 'video') return;
    const duration = Number.isFinite(video.duration) ? video.duration : Infinity;
    const next = Math.min(Math.max(0, video.currentTime + deltaSeconds), duration);
    video.currentTime = next;
  }

  function scheduleScrubPreview(frame: number): void {
    if (activeSource.kind !== 'video') return;

    scrubPreviewFrame = frame;
    if (scrubPreviewRaf !== null) return;

    scrubPreviewRaf = window.requestAnimationFrame(() => {
      scrubPreviewRaf = null;
      video.pause();
      commitSeek(scrubPreviewFrame);
      updateTransportUi();
    });
  }

  function flushScrubPreview(frame: number): void {
    if (scrubPreviewRaf !== null) {
      window.cancelAnimationFrame(scrubPreviewRaf);
      scrubPreviewRaf = null;
    }
    video.pause();
    commitSeek(frame);
  }

  function shouldIgnoreTransportShortcut(target: EventTarget | null): boolean {
    if (!(target instanceof Element)) return false;
    if (target instanceof HTMLTextAreaElement) return true;
    if (target instanceof HTMLSelectElement) return true;
    if (target instanceof HTMLInputElement) {
      const type = target.type.toLowerCase();
      return type !== 'range' && type !== 'button' && type !== 'checkbox' && type !== 'radio';
    }
    return target.getAttribute('contenteditable') === 'true';
  }

  function getRecordedTrack(trackId: 'A' | 'B') {
    return recordedTrackSet?.tracks.find((track) => track.id === trackId) ?? null;
  }

  function replaceRecordedTrack(trackId: 'A' | 'B', nextTrack: NonNullable<ReturnType<typeof getRecordedTrack>>): void {
    if (!recordedTrackSet) return;
    recordedTrackSet.tracks = recordedTrackSet.tracks.map((track) =>
      track.id === trackId ? nextTrack : track
    );
  }

  function currentRecordedFrame(): number {
    return frameIndex(video.currentTime, getRecordedFps());
  }

  function seekToRecordedFrame(frame: number): void {
    const duration = Number.isFinite(video.duration) ? video.duration : 0;
    video.currentTime = seekTimeForFrame(frame, getRecordedFps(), duration);
  }

  function stepRecordedFrames(delta: number): void {
    video.pause();
    seekToRecordedFrame(currentRecordedFrame() + delta);
  }

  function renderRecordedKeyframeList(): void {
    recordedKeyframeList.innerHTML = '';

    const track = getRecordedTrack(recordedActiveTrack);
    if (!track) {
      recordedKeyframeList.innerHTML = '<div class="hint">No active track.</div>';
      updateTransportUi();
      return;
    }

    const rows = listKeyframesWithFrames(track, getRecordedFps());
    if (rows.length === 0) {
      recordedKeyframeList.innerHTML = '<div class="hint">No keyframes yet.</div>';
      updateTransportUi();
      return;
    }

    for (const row of rows) {
      const rowEl = document.createElement('div');
      rowEl.className = 'recorded-keyframe-row';

      const jump = document.createElement('button');
      jump.type = 'button';
      jump.className = 'recorded-keyframe-jump';
      jump.dataset.frame = String(row.frame);
      jump.textContent = `f${row.frame}  ${formatClock(row.time)}`;

      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'recorded-keyframe-delete';
      del.dataset.frame = String(row.frame);
      del.textContent = 'Del';

      rowEl.appendChild(jump);
      rowEl.appendChild(del);
      recordedKeyframeList.appendChild(rowEl);
    }

    updateTransportUi();
  }

  function upsertActiveTrackKeyframe(x: number, y: number): void {
    const track = getRecordedTrack(recordedActiveTrack);
    if (!track) return;

    const nextTrack = upsertKeyframeAtFrame(
      track,
      currentRecordedFrame(),
      x,
      y,
      getRecordedFps()
    );
    replaceRecordedTrack(recordedActiveTrack, nextTrack);
    renderRecordedKeyframeList();
    scheduleRecordedAutosave();
  }

  function deleteActiveTrackKeyframeAtCurrentFrame(): boolean {
    const track = getRecordedTrack(recordedActiveTrack);
    if (!track) return false;

    const frame = currentRecordedFrame();
    const existing = keyframeAtFrame(track, frame, getRecordedFps());
    if (!existing) return false;

    const nextTrack = deleteKeyframeAtFrame(track, frame, getRecordedFps());
    replaceRecordedTrack(recordedActiveTrack, nextTrack);
    renderRecordedKeyframeList();
    scheduleRecordedAutosave();
    return true;
  }

  function jumpNeighborKeyframe(direction: -1 | 1): void {
    const track = getRecordedTrack(recordedActiveTrack);
    if (!track) return;
    const neighbors = nearestNeighborFrames(track, currentRecordedFrame(), getRecordedFps());
    const target = direction < 0 ? neighbors.previous : neighbors.next;
    if (!target) return;
    video.pause();
    seekToRecordedFrame(target.frame);
  }

  function applyRecordedAutoAdvance(): void {
    if (recordedAutoAdvanceMode === 'next') {
      jumpNeighborKeyframe(1);
      return;
    }
    if (recordedAutoAdvanceMode > 0) {
      stepRecordedFrames(recordedAutoAdvanceMode);
    }
  }

  function drawDiamond(ctx: CanvasRenderingContext2D, x: number, y: number, size: number): void {
    ctx.beginPath();
    ctx.moveTo(x, y - size);
    ctx.lineTo(x + size, y);
    ctx.lineTo(x, y + size);
    ctx.lineTo(x - size, y);
    ctx.closePath();
  }

  function drawFencersDebugOverlay(overlayCanvas: HTMLCanvasElement, frame: FrameData): void {
    if (frame.trackingMode !== 'fencers') return;
    const ctx = overlayCanvas.getContext('2d');
    if (!ctx) return;

    const lengthDiagnostics = new Map<'A' | 'B', { raw: number; smooth: number; delta: number }>();
    for (const detection of frame.detections) {
      const raw = detection.rawExtensionLength;
      const smooth = detection.smoothedExtensionLength;
      if (typeof raw !== 'number' || typeof smooth !== 'number') continue;
      if (!Number.isFinite(raw) || !Number.isFinite(smooth)) continue;
      const id: 'A' | 'B' = detection.id === 'B' ? 'B' : 'A';
      lengthDiagnostics.set(id, { raw, smooth, delta: Math.abs(raw - smooth) });
    }

    if (frame.debugMode === 'skeleton' || frame.debugMode === 'all') {
      const state = appState.get();
      const aExt = state.fencerATipExtension.toFixed(1);
      const bExt = state.fencerBTipExtension.toFixed(1);
      const aSmooth = state.fencerALengthSmoothingAlpha.toFixed(2);
      const bSmooth = state.fencerBLengthSmoothingAlpha.toFixed(2);
      const aAlpha = (1 - state.fencerALengthSmoothingAlpha).toFixed(2);
      const bAlpha = (1 - state.fencerBLengthSmoothingAlpha).toFixed(2);
      const refinementMode = fencersTipRefinementEnabledInput.checked ? 'on' : 'off';
      const aWrist = Math.round(state.fencerAWristWeight * 100);
      const bWrist = Math.round(state.fencerBWristWeight * 100);
      const aAngle = Math.round(state.fencerAAngleOffsetDeg);
      const bAngle = Math.round(state.fencerBAngleOffsetDeg);
      const aDiag = lengthDiagnostics.get('A');
      const bDiag = lengthDiagnostics.get('B');
      const aLen = aDiag
        ? `L${aDiag.raw.toFixed(3)}->${aDiag.smooth.toFixed(3)} d${aDiag.delta.toFixed(3)}`
        : 'L--';
      const bLen = bDiag
        ? `L${bDiag.raw.toFixed(3)}->${bDiag.smooth.toFixed(3)} d${bDiag.delta.toFixed(3)}`
        : 'L--';
      ctx.save();
      ctx.fillStyle = 'rgba(0, 0, 0, 0.45)';
      ctx.fillRect(10, 10, 560, 54);
      ctx.fillStyle = '#f4f4f4';
      ctx.font = '11px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';
      ctx.textAlign = 'left';
      ctx.textBaseline = 'middle';
      ctx.fillText('Blade lines: F=Forearm W=Wrist B=Blend+Angle', 16, 21);
      ctx.fillText(
        `R:${refinementMode} | A E${aExt}x S${aSmooth}/a${aAlpha} W${aWrist}% A${aAngle}deg | B E${bExt}x S${bSmooth}/a${bAlpha} W${bWrist}% A${bAngle}deg`,
        16,
        36
      );
      ctx.fillText(`A ${aLen} | B ${bLen}`, 16, 50);
      ctx.restore();
    }

    for (const detection of frame.detections) {
      const color = detection.id === 'B' ? '#ff4d5a' : '#36d67a';
      const hasRefinement = Boolean(detection.refinement);
      const confidence = detection.refinement ? Math.round(detection.refinement.confidence * 100) : Math.round(detection.tip.confidence * 100);
      const armSide = detection.arm ?? detection.refinement?.arm;
      const arm = armSide ? armSide[0].toUpperCase() : '?';
      const rawLen = detection.rawExtensionLength;
      const smoothLen = detection.smoothedExtensionLength;
      const delta =
        typeof rawLen === 'number' &&
        typeof smoothLen === 'number' &&
        Number.isFinite(rawLen) &&
        Number.isFinite(smoothLen)
          ? Math.abs(rawLen - smoothLen)
          : null;
      const lenLabel =
        delta !== null && typeof rawLen === 'number' && typeof smoothLen === 'number'
          ? ` L${rawLen.toFixed(3)}->${smoothLen.toFixed(3)} d${delta.toFixed(3)}`
          : '';
      const label = `${detection.id} ${arm} ${confidence}%${lenLabel}`;
      const labelAnchor = detection.refinement
        ? mapToCanvas(detection.refinement.refined.x, detection.refinement.refined.y)
        : mapToCanvas(detection.tip.x, detection.tip.y);

      ctx.save();
      ctx.strokeStyle = color;
      ctx.fillStyle = color;
      ctx.lineWidth = 1.5;
      ctx.globalAlpha = 0.95;

      if (hasRefinement && detection.refinement) {
        const prior = mapToCanvas(detection.refinement.prior.x, detection.refinement.prior.y);
        const refined = mapToCanvas(detection.refinement.refined.x, detection.refinement.refined.y);
        const start = mapToCanvas(detection.refinement.searchStart.x, detection.refinement.searchStart.y);
        const end = mapToCanvas(detection.refinement.searchEnd.x, detection.refinement.searchEnd.y);

        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        ctx.moveTo(start.x, start.y);
        ctx.lineTo(end.x, end.y);
        ctx.stroke();

        ctx.setLineDash([]);
        ctx.beginPath();
        ctx.arc(prior.x, prior.y, 4, 0, Math.PI * 2);
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(refined.x, refined.y, 3, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.font = '11px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'left';
      ctx.textBaseline = 'middle';
      ctx.fillText(label, labelAnchor.x + 7, labelAnchor.y - 8);
      ctx.restore();
    }
  }

  function drawRecordedEditorOverlay(overlayCanvas: HTMLCanvasElement): void {
    if (!isRecordedEditorActive() || !recordedTrackSet) return;
    const ctx = overlayCanvas.getContext('2d');
    if (!ctx) return;

    const frame = currentRecordedFrame();
    const fps = getRecordedFps();

    const activeTrack = getRecordedTrack(recordedActiveTrack);
    if (activeTrack) {
      const activeNeighbors = nearestNeighborFrames(activeTrack, frame, fps);
      const start = activeNeighbors.previous ?? activeNeighbors.current;
      const end = activeNeighbors.next ?? activeNeighbors.current;
      if (start && end && end.time > start.time) {
        const points: Array<{ x: number; y: number }> = [];
        const steps = 24;
        for (let i = 0; i <= steps; i++) {
          const t = start.time + ((end.time - start.time) * i) / steps;
          const sample = sampleTrackAt(activeTrack, t, {
            fps,
            maxGapSeconds: recordedTrackSet.maxGapSeconds,
          });
          if (!sample) continue;
          points.push(mapToCanvas(sample.x, sample.y));
        }

        if (points.length >= 2) {
          ctx.save();
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.45)';
          ctx.lineWidth = 1.5;
          ctx.setLineDash([5, 5]);
          ctx.beginPath();
          ctx.moveTo(points[0].x, points[0].y);
          for (let i = 1; i < points.length; i++) {
            ctx.lineTo(points[i].x, points[i].y);
          }
          ctx.stroke();
          ctx.restore();
        }
      } else if (activeNeighbors.previous && activeNeighbors.next) {
        const p = mapToCanvas(activeNeighbors.previous.x, activeNeighbors.previous.y);
        const n = mapToCanvas(activeNeighbors.next.x, activeNeighbors.next.y);
        ctx.save();
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.45)';
        ctx.lineWidth = 1.5;
        ctx.setLineDash([5, 5]);
        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
        ctx.lineTo(n.x, n.y);
        ctx.stroke();
        ctx.restore();
      }

      if (!activeNeighbors.current) {
        const interpolated = sampleTrackAt(activeTrack, video.currentTime, {
          fps,
          maxGapSeconds: recordedTrackSet.maxGapSeconds,
        });
        if (interpolated) {
          const point = mapToCanvas(interpolated.x, interpolated.y);
          ctx.save();
          ctx.fillStyle = activeTrack.color;
          ctx.globalAlpha = 0.9;
          ctx.beginPath();
          ctx.arc(point.x, point.y, 3.5, 0, Math.PI * 2);
          ctx.fill();

          ctx.globalAlpha = 1;
          ctx.strokeStyle = '#ffffff';
          ctx.lineWidth = 1.5;
          ctx.setLineDash([3, 3]);
          ctx.beginPath();
          ctx.arc(point.x, point.y, 7, 0, Math.PI * 2);
          ctx.stroke();
          ctx.restore();
        }
      }
    }

    (['A', 'B'] as const).forEach((trackId) => {
      const track = getRecordedTrack(trackId);
      if (!track) return;

      const neighbors = nearestNeighborFrames(track, frame, fps);
      const items = [
        { kind: 'previous' as const, keyframe: neighbors.previous },
        { kind: 'next' as const, keyframe: neighbors.next },
        { kind: 'current' as const, keyframe: neighbors.current },
      ];

      for (const item of items) {
        if (!item.keyframe) continue;
        const pos = mapToCanvas(item.keyframe.x, item.keyframe.y);
        const isActiveTrack = trackId === recordedActiveTrack;
        const alpha = isActiveTrack
          ? item.kind === 'current'
            ? 0.95
            : item.kind === 'previous'
              ? 0.72
              : 0.56
          : 0.35;
        const size = item.kind === 'current' ? 7 : 5;

        ctx.save();
        ctx.fillStyle = track.color;
        ctx.globalAlpha = alpha;
        drawDiamond(ctx, pos.x, pos.y, size);
        ctx.fill();

        if (isActiveTrack && item.kind !== 'current') {
          ctx.globalAlpha = 0.95;
          ctx.fillStyle = '#ffffff';
          ctx.font = '10px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'bottom';
          ctx.fillText(item.kind === 'previous' ? 'P' : 'N', pos.x, pos.y - size - 3);
        }

        if (item.kind === 'current' && isActiveTrack) {
          ctx.globalAlpha = 1;
          ctx.strokeStyle = '#ffffff';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.arc(pos.x, pos.y, size + 4, 0, Math.PI * 2);
          ctx.stroke();
        }
        ctx.restore();
      }
    });
  }

  // ---- Source control ----
  async function startCamera(): Promise<void> {
    if (activeSource.kind !== 'camera' || activeSource.isAttached()) return;

    try {
      await activeSource.attach(video);
      toggleCameraBtn.textContent = 'Stop Camera';
      detectionStatus.textContent = detector.isReady() ? 'Running' : 'Loading model...';
      updatePlaybackStatus();
      mainLoop.start();
    } catch (err) {
      console.error('Failed to access camera:', err);
      detectionStatus.textContent = 'Camera access denied';
    }
  }

  function stopCamera(): void {
    if (activeSource.kind !== 'camera' || !activeSource.isAttached()) return;

    activeSource.detach();
    toggleCameraBtn.textContent = 'Start Camera';
    detectionStatus.textContent = detector.isReady() ? 'Ready' : 'Loading model...';
    updatePlaybackStatus();
  }

  async function toggleCamera(): Promise<void> {
    if (activeSource.kind !== 'camera') return;
    if (activeSource.isAttached()) stopCamera();
    else await startCamera();
  }

  async function loadVideoFromInput(): Promise<void> {
    if (activeSource.kind !== 'video') {
      await switchSource('video');
    }

    const url = videoUrlInput.value.trim();
    if (!url) {
      detectionStatus.textContent = 'Paste a video URL first';
      return;
    }

    urlSource.setUrl(url);
    detectionStatus.textContent = 'Loading video...';

    try {
      await urlSource.attach(video);
      setVideoQueryParam(url);
      await detectTransportFps(url);
      await loadOrCreateRecordedTrackSet(url);
      void refreshSavedVideosList({ silent: true });
      updatePlaybackStatus();
      if (appState.get().trackingMode === 'recorded') {
        detectionStatus.textContent = video.paused ? 'Recorded mode - tap Play' : 'Recorded mode';
      } else if (video.paused) {
        detectionStatus.textContent = 'Video loaded - tap Play';
      } else {
        detectionStatus.textContent = detector.isReady() ? 'Running' : 'Loading model...';
      }
      mainLoop.start();
    } catch (err) {
      console.error('Failed to load video URL:', err);
      detectionStatus.textContent =
        err instanceof UnsupportedVideoSourceError ? err.message : 'Failed to load video URL';
      updatePlaybackStatus();
    }
  }

  async function loadVideoFromLibrary(url: string): Promise<void> {
    if (!url) return;
    videoUrlInput.value = url;
    savedVideosStatus.textContent = 'Loading selected library video...';
    await loadVideoFromInput();

    if (activeSource.kind === 'video' && currentVideoUrl === url) {
      appState.update({ trackingMode: 'recorded' });
      savedVideosStatus.textContent = 'Loaded from saved library entry.';
    }
  }

  async function switchSource(kind: SourceKind, options: { autoLoadVideo?: boolean } = {}): Promise<void> {
    const shouldAutoLoad = options.autoLoadVideo === true;
    if (switchingSource) return;
    if (activeSource.kind === kind && !shouldAutoLoad) return;

    switchingSource = true;

    try {
      if (activeSource.isAttached()) {
        activeSource.detach();
      }

      if (scrubPreviewRaf !== null) {
        window.cancelAnimationFrame(scrubPreviewRaf);
        scrubPreviewRaf = null;
      }

      if (recordedSaveTimer !== null) {
        window.clearTimeout(recordedSaveTimer);
        recordedSaveTimer = null;
      }

      trailManager.clear();
      mainLoop.clearDetections();

      if (kind === 'camera') {
        currentVideoId = null;
        currentVideoUrl = '';
        resetAutoSeedCapture();
        recordedTrackSet = null;
        recordedStatusNote = null;
        recordedEditMode = false;
        recordedEditToggle.checked = false;
        renderRecordedKeyframeList();
        setTransportFps(DEFAULT_FRAME_RATE, true);
        activeSource = cameraSource;
        applySourcePresentation();
        refreshOverlaySizing?.();
        await startCamera();
      } else {
        currentVideoId = null;
        currentVideoUrl = '';
        resetAutoSeedCapture();
        recordedTrackSet = null;
        recordedStatusNote = null;
        recordedEditMode = false;
        recordedEditToggle.checked = false;
        renderRecordedKeyframeList();
        activeSource = urlSource;
        applySourcePresentation();
        refreshOverlaySizing?.();
        detectionStatus.textContent = 'Video mode: paste URL and click Load';

        if (shouldAutoLoad) {
          await loadVideoFromInput();
        }
      }
    } finally {
      switchingSource = false;
    }
  }

  // ---- UI events ----
  menuToggle.addEventListener('click', () => {
    controls.classList.toggle('collapsed');
  });

  document.addEventListener('click', (e) => {
    if (isRecordedEditorActive() && container.contains(e.target as Node)) {
      return;
    }
    if (!controls.contains(e.target as Node) && !menuToggle.contains(e.target as Node)) {
      controls.classList.add('collapsed');
    }
  });

  sourceModeSelect.addEventListener('change', (e) => {
    const kind = (e.target as HTMLSelectElement).value as SourceKind;
    void switchSource(kind);
  });

  loadVideoBtn.addEventListener('click', () => {
    void loadVideoFromInput();
  });

  savedVideosRefreshBtn.addEventListener('click', () => {
    void refreshSavedVideosList();
  });

  savedVideosList.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (!(target instanceof HTMLButtonElement)) return;
    if (!target.classList.contains('saved-video-load')) return;

    const url = target.dataset.videoUrl?.trim() ?? '';
    if (!url) return;
    void loadVideoFromLibrary(url);
  });

  recordedGenerateDraftBtn.addEventListener('click', () => {
    generateRecordedDraftFromLive();
  });

  videoUrlInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      void loadVideoFromInput();
    }
  });

  recordedImportPasteBtn.addEventListener('click', () => {
    if (!currentVideoId || !currentVideoUrl) {
      updateRecordedStatus('Load a video first.');
      return;
    }

    const text = recordedJsonInput.value.trim();
    if (!text) {
      recordedImportFileInput.click();
      return;
    }

    const imported = importTrackSetFromJson(text, currentVideoId, currentVideoUrl, transportFps);
    if (!imported) {
      updateRecordedStatus('Import failed: invalid track-set JSON.');
      return;
    }

    imported.videoId = currentVideoId;
    imported.videoUrl = currentVideoUrl;
    imported.fps = imported.fps || transportFps;
    recordedTrackSet = imported;
    recordedStatusNote = null;
    scheduleRecordedAutosave(0);
    renderRecordedKeyframeList();
    trailManager.clear();
    mainLoop.clearDetections();
    updateRecordedStatus('Imported recorded track set.');
  });

  recordedImportFileInput.addEventListener('change', async () => {
    if (!currentVideoId || !currentVideoUrl) {
      updateRecordedStatus('Load a video first.');
      recordedImportFileInput.value = '';
      return;
    }

    const file = recordedImportFileInput.files?.[0];
    if (!file) return;

    const text = await file.text();
    const imported = importTrackSetFromJson(text, currentVideoId, currentVideoUrl, transportFps);
    recordedImportFileInput.value = '';
    if (!imported) {
      updateRecordedStatus('Import failed: invalid file JSON.');
      return;
    }

    imported.videoId = currentVideoId;
    imported.videoUrl = currentVideoUrl;
    imported.fps = imported.fps || transportFps;
    recordedTrackSet = imported;
    recordedStatusNote = null;
    scheduleRecordedAutosave(0);
    renderRecordedKeyframeList();
    trailManager.clear();
    mainLoop.clearDetections();
    updateRecordedStatus(`Imported ${file.name}.`);
  });

  recordedExportJsonBtn.addEventListener('click', () => {
    if (!recordedTrackSet || !currentVideoId) {
      updateRecordedStatus('Nothing to export yet.');
      return;
    }

    const payload = exportTrackSetToJson(recordedTrackSet);
    const blob = new Blob([payload], { type: 'application/json' });
    const href = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = href;
    a.download = exportFilenameForVideo(currentVideoUrl, currentVideoId);
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(href);
    updateRecordedStatus('Exported recorded track set.');
  });

  recordedEditToggle.addEventListener('change', () => {
    recordedEditMode = recordedEditToggle.checked;
    updateRecordedEditorControlsVisibility();
    updateEditOverlayInteractivity();
  });

  recordedActiveTrackSelect.addEventListener('change', (e) => {
    recordedActiveTrack = (e.target as HTMLSelectElement).value === 'B' ? 'B' : 'A';
    renderRecordedKeyframeList();
  });

  recordedAutoAdvanceSelect.addEventListener('change', (e) => {
    const next = parseRecordedAutoAdvanceMode((e.target as HTMLSelectElement).value);
    if (next !== null) {
      recordedAutoAdvanceMode = next;
      localStorage.setItem(RECORDED_AUTO_ADVANCE_STORAGE_KEY, String(next));
    }
  });

  recordedDeleteFrameBtn.addEventListener('click', () => {
    if (!isRecordedEditorActive()) return;
    if (deleteActiveTrackKeyframeAtCurrentFrame()) {
      updateRecordedStatus('Deleted keyframe at current frame.');
    }
  });

  recordedClearTrackBtn.addEventListener('click', () => {
    if (!isRecordedEditorActive() || !recordedTrackSet) return;
    const label = recordedActiveTrack === 'A' ? 'Track A (green)' : 'Track B (red)';
    if (!window.confirm(`Clear all keyframes from ${label}?`)) return;
    const track = getRecordedTrack(recordedActiveTrack);
    if (!track) return;
    replaceRecordedTrack(recordedActiveTrack, { ...track, keyframes: [] });
    renderRecordedKeyframeList();
    scheduleRecordedAutosave();
    updateRecordedStatus(`Cleared ${label}.`);
  });

  recordedKeyframeList.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!(target instanceof HTMLButtonElement)) return;
    const frame = Number.parseInt(target.dataset.frame ?? '', 10);
    if (!Number.isFinite(frame)) return;

    if (target.classList.contains('recorded-keyframe-jump')) {
      video.pause();
      seekToRecordedFrame(frame);
      return;
    }

    if (target.classList.contains('recorded-keyframe-delete')) {
      const track = getRecordedTrack(recordedActiveTrack);
      if (!track) return;
      replaceRecordedTrack(recordedActiveTrack, deleteKeyframeAtFrame(track, frame, getRecordedFps()));
      renderRecordedKeyframeList();
      scheduleRecordedAutosave();
    }
  });

  trackingModeSelect.addEventListener('change', (e) => {
    if (!detector.isSwitching()) {
      const mode = (e.target as HTMLSelectElement).value as TrackingMode;
      if (mode === 'recorded' && activeSource.kind !== 'video') {
        trackingModeSelect.value = appState.get().trackingMode;
        return;
      }
      appState.update({ trackingMode: mode });
    }
  });

  fencersDebugOverlayInput.addEventListener('change', () => {
    showFencersDebugOverlay = fencersDebugOverlayInput.checked;
  });

  fencersTipRefinementEnabledInput.addEventListener('change', () => {
    setFencerTipRefinementEnabled(fencersTipRefinementEnabledInput.checked);
  });

  debugModeSelect.addEventListener('change', (e) => {
    appState.update({ debugMode: (e.target as HTMLSelectElement).value as DebugMode });
  });

  trailLengthInput.addEventListener('input', (e) => {
    const value = parseInt((e.target as HTMLInputElement).value);
    trailLengthValue.textContent = value.toString();
    appState.update({ trailLength: value });
  });

  inferenceRateInput.addEventListener('input', (e) => {
    const value = parseInt((e.target as HTMLInputElement).value);
    inferenceRateValue.textContent = value.toString();
    appState.update({ inferenceFps: value });
  });

  glowIntensityInput.addEventListener('input', (e) => {
    const value = parseFloat((e.target as HTMLInputElement).value);
    glowIntensityValue.textContent = value.toFixed(1);
    appState.update({ glowIntensity: value });
  });

  poseTipExtensionInput.addEventListener('input', (e) => {
    const value = parseFloat((e.target as HTMLInputElement).value);
    poseTipExtensionValue.textContent = value.toFixed(1);
    appState.update({ poseTipExtension: value });
  });

  fencerATipExtensionInput.addEventListener('input', (e) => {
    const value = parseFloat((e.target as HTMLInputElement).value);
    fencerATipExtensionValue.textContent = value.toFixed(1);
    appState.update({ fencerATipExtension: value });
  });

  fencerBTipExtensionInput.addEventListener('input', (e) => {
    const value = parseFloat((e.target as HTMLInputElement).value);
    fencerBTipExtensionValue.textContent = value.toFixed(1);
    appState.update({ fencerBTipExtension: value });
  });

  fencerALengthSmoothingAlphaInput.addEventListener('input', (e) => {
    const value = parseFloat((e.target as HTMLInputElement).value);
    fencerALengthSmoothingAlphaValue.textContent = value.toFixed(2);
    appState.update({ fencerALengthSmoothingAlpha: value });
  });

  fencerBLengthSmoothingAlphaInput.addEventListener('input', (e) => {
    const value = parseFloat((e.target as HTMLInputElement).value);
    fencerBLengthSmoothingAlphaValue.textContent = value.toFixed(2);
    appState.update({ fencerBLengthSmoothingAlpha: value });
  });

  fencerAWristWeightInput.addEventListener('input', (e) => {
    const value = parseInt((e.target as HTMLInputElement).value, 10);
    fencerAWristWeightValue.textContent = String(value);
    appState.update({ fencerAWristWeight: value / 100 });
  });

  fencerBWristWeightInput.addEventListener('input', (e) => {
    const value = parseInt((e.target as HTMLInputElement).value, 10);
    fencerBWristWeightValue.textContent = String(value);
    appState.update({ fencerBWristWeight: value / 100 });
  });

  fencerAAngleOffsetInput.addEventListener('input', (e) => {
    const value = parseInt((e.target as HTMLInputElement).value, 10);
    fencerAAngleOffsetValue.textContent = String(value);
    appState.update({ fencerAAngleOffsetDeg: value });
  });

  fencerBAngleOffsetInput.addEventListener('input', (e) => {
    const value = parseInt((e.target as HTMLInputElement).value, 10);
    fencerBAngleOffsetValue.textContent = String(value);
    appState.update({ fencerBAngleOffsetDeg: value });
  });

  effectModeSelect.addEventListener('change', (e) => {
    appState.update({ effectMode: (e.target as HTMLSelectElement).value as EffectMode });
  });

  clearTrailsBtn.addEventListener('click', () => {
    trailManager.clear();
  });

  toggleCameraBtn.addEventListener('click', () => {
    void toggleCamera();
  });

  overlay.addEventListener('click', (e) => {
    if (!isRecordedEditorActive()) return;

    video.pause();
    const norm = mapToNormalized(e.clientX, e.clientY);
    upsertActiveTrackKeyframe(norm.x, norm.y);
    applyRecordedAutoAdvance();
  });

  transportPlayPauseBtn.addEventListener('click', async () => {
    if (activeSource.kind !== 'video') return;
    if (video.paused || video.ended) {
      await tryPlayVideo();
    } else {
      video.pause();
    }
    updateTransportUi();
  });

  transportStepBackBtn.addEventListener('click', () => {
    stepFrames(-1);
  });

  transportStepForwardBtn.addEventListener('click', () => {
    stepFrames(1);
  });

  transportPrevKeyframeBtn.addEventListener('click', () => {
    jumpNeighborKeyframe(-1);
  });

  transportNextKeyframeBtn.addEventListener('click', () => {
    jumpNeighborKeyframe(1);
  });

  transportSeek.addEventListener('pointerdown', () => {
    isDraggingSeek = true;
  });

  transportSeek.addEventListener('input', (e) => {
    const frame = parseInt((e.target as HTMLInputElement).value, 10);
    seekDragFrame = Number.isFinite(frame) ? frame : 0;
    isDraggingSeek = true;
    scheduleScrubPreview(seekDragFrame);
    updateTransportUi();
  });

  const commitSeekFromSlider = () => {
    const frame = parseInt(transportSeek.value, 10);
    isDraggingSeek = false;
    flushScrubPreview(Number.isFinite(frame) ? frame : 0);
    updateTransportUi();
  };

  transportSeek.addEventListener('change', commitSeekFromSlider);
  transportSeek.addEventListener('pointerup', commitSeekFromSlider);

  transportFpsBtn.addEventListener('click', () => {
    if (!currentVideoId) return;
    const response = window.prompt('Override FPS for this video', transportFps.toFixed(2));
    if (response === null) return;
    const parsed = Number.parseFloat(response.trim());
    if (!Number.isFinite(parsed) || parsed <= 1 || parsed > 240) return;
    saveFpsOverride(currentVideoId, parsed);
    setTransportFps(parsed, false);
    if (recordedTrackSet) {
      recordedTrackSet.fps = parsed;
      scheduleRecordedAutosave(0);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (activeSource.kind !== 'video') return;
    if (e.altKey || e.ctrlKey || e.metaKey) return;
    if (shouldIgnoreTransportShortcut(e.target)) return;

    const inRecordedMode = appState.get().trackingMode === 'recorded';

    if (inRecordedMode) {
      if (e.key === '[' || e.key === ',' || e.key === 'PageUp') {
        e.preventDefault();
        jumpNeighborKeyframe(-1);
        return;
      }
      if (e.key === ']' || e.key === '.' || e.key === 'PageDown') {
        e.preventDefault();
        jumpNeighborKeyframe(1);
        return;
      }
    }

    if (isRecordedEditorActive()) {
      if (e.key === 'Delete' || e.key === 'Backspace') {
        e.preventDefault();
        deleteActiveTrackKeyframeAtCurrentFrame();
        return;
      }
    }

    switch (e.key) {
      case ' ': {
        e.preventDefault();
        void (async () => {
          if (video.paused || video.ended) await tryPlayVideo();
          else video.pause();
          updateTransportUi();
        })();
        break;
      }
      case 'ArrowLeft': {
        e.preventDefault();
        if (e.shiftKey) seekSeconds(-1);
        else stepFrames(-1);
        break;
      }
      case 'ArrowRight': {
        e.preventDefault();
        if (e.shiftKey) seekSeconds(1);
        else stepFrames(1);
        break;
      }
      case 'Home': {
        e.preventDefault();
        video.currentTime = 0;
        break;
      }
      case 'End': {
        if (Number.isFinite(video.duration)) {
          e.preventDefault();
          video.currentTime = Math.max(0, video.duration);
        }
        break;
      }
      default:
        break;
    }
  });

  video.addEventListener('seeking', () => {
    if (activeSource.kind === 'video') {
      trailManager.clear();
      mainLoop.clearDetections();
    }
  });

  const playbackEvents = [
    'loadedmetadata',
    'loadeddata',
    'durationchange',
    'timeupdate',
    'play',
    'pause',
    'seeking',
    'seeked',
    'ended',
    'resize',
  ];
  for (const eventName of playbackEvents) {
    video.addEventListener(eventName, updatePlaybackStatus);
  }

  // ---- Start ----
  async function init() {
    applySourcePresentation();
    renderRecordedKeyframeList();
    refreshOverlaySizing = installOverlaySizing(video, overlay, [trailRenderer, debugRenderer]);

    await detector.load(appState.get().trackingMode);

    const initialVideoUrl = new URL(window.location.href).searchParams.get('video')?.trim() ?? '';
    if (initialVideoUrl) {
      videoUrlInput.value = initialVideoUrl;
      urlSource.setUrl(initialVideoUrl);
      await switchSource('video', { autoLoadVideo: true });
    } else {
      await startCamera();
    }
  }

  void init();
</script>

<style>
  #container {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    height: -webkit-fill-available;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #000;
    position: fixed;
    top: 0;
    left: 0;
    overflow: hidden;
  }

  .video-element {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .video-element.fit-cover {
    object-fit: cover;
  }

  .video-element.fit-contain {
    object-fit: contain;
  }

  .video-element.mirrored {
    transform: scaleX(-1);
  }

  .overlay-canvas {
    position: absolute;
    pointer-events: none;
    width: 100%;
    height: 100%;
  }

  .overlay-canvas.edit-mode {
    pointer-events: auto;
    cursor: crosshair;
  }

  .overlay-canvas.mirrored {
    transform: scaleX(-1);
  }
</style>
