{
	"compatibility_date": "2026-04-24",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "tip-track",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "TRACKS",
			"id": "00000000000000000000000000000000"
		}
	],
	"observability": {
		"enabled": true
	}
}
